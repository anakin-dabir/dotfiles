#!/usr/bin/env python3
"""Screen and lock when you're away (Control Center > Power > Screen & lock).

Settings in config/power.json:
  screen_dark   minutes without input until the screen goes dark (0 = never)
  lock_after    minutes without input until the screen locks (0 = never)
  lock_on_sleep lock the screen before the computer goes to sleep

"Dark" is the backlight at zero, back as soon as you touch anything. (Not
DPMS: this laptop's panel fails to wake from it - see bspwmrc.)
Nothing happens while Keep awake is on, media is playing or a window is full
screen. Started from bspwmrc; only one runs.
"""

import ctypes
import fcntl
import json
import os
import subprocess
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".config", "bspwm", "config", "power.json")
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "barpanel")
LOCKER = os.path.join(HOME, ".config", "bspwm", "bin", "ScreenLocker")


class _Info(ctypes.Structure):
    _fields_ = [("window", ctypes.c_ulong), ("state", ctypes.c_int), ("kind", ctypes.c_int),
                ("til_or_since", ctypes.c_ulong), ("idle", ctypes.c_ulong), ("event_mask", ctypes.c_ulong)]


class Idle:
    """Milliseconds since the last key press or mouse move (X screensaver extension)."""

    def __init__(self):
        self.x11 = ctypes.CDLL("libX11.so.6")
        self.xss = ctypes.CDLL("libXss.so.1")
        self.x11.XOpenDisplay.restype = ctypes.c_void_p
        self.x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
        self.x11.XDefaultRootWindow.restype = ctypes.c_ulong
        self.xss.XScreenSaverAllocInfo.restype = ctypes.POINTER(_Info)
        self.xss.XScreenSaverQueryInfo.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(_Info)]
        self.dpy = self.x11.XOpenDisplay(None)
        if not self.dpy:
            sys.exit("IdleWatch: no X display")
        self.root = self.x11.XDefaultRootWindow(self.dpy)
        self.info = self.xss.XScreenSaverAllocInfo()

    def ms(self):
        self.xss.XScreenSaverQueryInfo(self.dpy, self.root, self.info)
        return self.info.contents.idle


def settings():
    try:
        with open(CONFIG) as f:
            s = json.load(f)
    except (OSError, ValueError):
        s = {}
    return {"screen_dark": int(s.get("screen_dark", 0)), "lock_after": int(s.get("lock_after", 0)),
            "lock_on_sleep": bool(s.get("lock_on_sleep", False))}


def out(argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def busy():
    """Keep awake on, media playing or a full-screen window: don't dim or lock."""
    try:
        with open(os.path.join(RUN, "awake.pid")) as f:
            os.kill(int(f.read().strip()), 0)
        return True
    except (OSError, ValueError):
        pass
    if "Playing" in out(["playerctl", "-a", "status"]):
        return True
    return bool(out(["bspc", "query", "-N", "-n", ".fullscreen.window.!hidden", "-d", "focused"]).strip())


def locked():
    return subprocess.run(["pgrep", "-x", "i3lock"], capture_output=True).returncode == 0


def lock():
    if not locked():
        subprocess.Popen([LOCKER], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


class Watch:
    def __init__(self):
        self.idle = Idle()
        self.dark_from = None        # brightness before going dark
        self.locked_now = False
        self.was_discharging = True        # (first check closes a warning left from before)
        self.fd = None
        self.bus = None
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            self.bus.signal_subscribe("org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
                                      "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE, self._sleep)
            self._inhibit()
        except GLib.Error:
            pass
        GLib.timeout_add(1000, self.tick)

    # ----- lock before sleeping -----

    def _inhibit(self):
        """Ask logind to wait a moment before sleeping (so the lock is up first)."""
        if self.fd is not None or self.bus is None or not settings()["lock_on_sleep"]:
            return
        try:
            res, fds = self.bus.call_with_unix_fd_list_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager", "Inhibit",
                GLib.Variant("(ssss)", ("sleep", "Screen lock", "Lock the screen before sleeping", "delay")),
                GLib.VariantType("(h)"), Gio.DBusCallFlags.NONE, -1, None, None)
            self.fd = fds.get(res.unpack()[0])
        except GLib.Error:
            self.fd = None

    def _release(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def _sleep(self, _bus, _sender, _path, _iface, _signal, params):
        going = params.unpack()[0]
        if going:
            if settings()["lock_on_sleep"]:
                lock()
                GLib.timeout_add(700, lambda: (self._release(), False)[1])     # (time to draw the lock)
            else:
                self._release()
        else:
            self._inhibit()

    # ----- dark screen, lock -----

    def _brightness(self):
        try:
            return int(out(["brightnessctl", "get"]).strip())
        except ValueError:
            return None

    def _wake(self):
        if self.dark_from is not None:
            subprocess.run(["brightnessctl", "-q", "set", str(self.dark_from)])
            self.dark_from = None

    def _plugged_in(self):
        """Plugged in: close the low-battery warning at once (it stays until
        clicked otherwise; bin/battery-warn only checks every minute)."""
        status = ""
        for d in ("BAT0", "BAT1"):
            try:
                with open(f"/sys/class/power_supply/{d}/status") as f:
                    status = f.read().strip()
                break
            except OSError:
                continue
        charging = status not in ("", "Discharging")
        if charging and self.was_discharging:
            subprocess.run(["dunstify", "-C", "991337"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            try:
                os.remove(os.path.join(RUN, "battery-action"))       # (a pending sleep: cancelled)
            except OSError:
                pass
        self.was_discharging = status == "Discharging"

    def tick(self):
        self._plugged_in()
        s = settings()
        if s["lock_on_sleep"] and self.fd is None:
            self._inhibit()
        elif not s["lock_on_sleep"]:
            self._release()
        idle = self.idle.ms() / 1000
        if idle < 2:                          # someone's here
            self._wake()
            self.locked_now = False
            return True
        due_dark = s["screen_dark"] and idle >= s["screen_dark"] * 60
        due_lock = s["lock_after"] and idle >= s["lock_after"] * 60
        if (due_dark and self.dark_from is None) or (due_lock and not self.locked_now):
            if busy():
                return True
            if due_lock and not self.locked_now:
                self.locked_now = True
                lock()
            if due_dark and self.dark_from is None:
                cur = self._brightness()
                if cur:
                    self.dark_from = cur
                    subprocess.run(["brightnessctl", "-q", "set", "0"])
        return True


def main():
    os.makedirs(RUN, exist_ok=True)
    me = open(os.path.join(RUN, "idlewatch.lock"), "w")
    try:
        fcntl.flock(me, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(0)                       # already running
    Watch()
    try:
        GLib.MainLoop().run()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
