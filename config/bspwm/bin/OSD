#!/usr/bin/env bash
# On-screen pop-up (eww/osd): a pill that fills with the accent colour up to the level,
# icon and value on top; near the bottom of the screen, gone 1.5 s after the last change.
#
#   OSD volume [N|muted]      OSD brightness N      OSD layout "English (US)"
#   OSD mic [N|muted]

BSPDIR="$HOME/.config/bspwm"
EWW=(timeout 2 eww --no-daemonize -c "$BSPDIR/eww")
RUN="${XDG_RUNTIME_DIR:-/tmp}/barpanel"; mkdir -p "$RUN"

kind=$1 value=$2 text=$3
bar=true off=false
case "$kind" in
    volume)
        if [ "$value" = muted ]; then icon="󰝟"; off=true; value=0; text=${text:-Muted}
        else
            v=${value:-0}
            if [ "$v" -ge 66 ]; then icon="󰕾"; elif [ "$v" -ge 33 ]; then icon="󰖀"; elif [ "$v" -gt 0 ]; then icon="󰕿"; else icon="󰝟"; fi
            text=${text:-Volume}
        fi ;;
    mic)
        if [ "$value" = muted ]; then icon="󰍭"; off=true; value=0; text=${text:-Microphone off}
        else icon="󰍬"; text=${text:-Microphone}; fi ;;
    brightness)
        v=${value:-0}
        if [ "$v" -ge 66 ]; then icon="󰃠"; elif [ "$v" -ge 33 ]; then icon="󰃟"; else icon="󰃞"; fi
        text=${text:-Brightness} ;;
    layout)
        icon="󰌌"; bar=false; text=${value:-Keyboard}; value=0 ;;
    *) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
[[ "$value" =~ ^[0-9]+$ ]] || value=0
[ "$value" -gt 100 ] && value=100

json=$(jq -nc --arg i "$icon" --argjson v "$value" --arg t "$text" --argjson b "$bar" --argjson o "$off" \
    '{icon: $i, value: $v, text: $t, bar: $b, off: $o}')
if ! "${EWW[@]}" update "osd=$json" >/dev/null 2>&1; then
    "$BSPDIR/bin/EwwDaemon" >/dev/null 2>&1 || exit 0
    "${EWW[@]}" update "osd=$json" >/dev/null 2>&1
fi
# Open it (once; while it's up, the update above is all it takes)
if ! xdotool search --onlyvisible --name '^Eww - osd$' >/dev/null 2>&1; then
    screen=0
    if [ "$(bspc query -M | wc -l)" -gt 1 ]; then
        mon=$(bspc query -M -m focused --names)
        screen=$(xrandr --listmonitors | awk -v n="$mon" '$NF == n { sub(":", "", $1); print $1 }')
    fi
    "${EWW[@]}" open osd --screen "${screen:-0}" >/dev/null 2>&1
fi
# Close 1.5 s after the last change (each change starts the wait again)
token=$(date +%s%N); echo "$token" > "$RUN/osd.token"
( sleep 1.5
  [ "$(cat "$RUN/osd.token" 2>/dev/null)" = "$token" ] && "${EWW[@]}" close osd >/dev/null 2>&1 ) \
  >/dev/null 2>&1 </dev/null &
disown
