#!/bin/bash
# Toggle the rainbow glow on the keyboard (super + alt + g).
# Off goes back to the saved colour. The effect itself lives in kbd-effect;
# Control Center > Keyboard has all the options.
BIN="$HOME/.config/bspwm/bin"
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/kbd-effect.pid"
SETTINGS="$HOME/.config/bspwm/config/keyboard.json"

if [ "$(jq -r '.effect // empty' "$SETTINGS" 2>/dev/null)" = rainbow ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
    color=$(jq -r '.color // empty' "$SETTINGS" 2>/dev/null)
    [[ "$color" =~ ^[0-9A-Fa-f]{6}$ ]] || color=$(cat /etc/kbd-backlight.conf 2>/dev/null)
    "$BIN/kbd-effect" static "$color"
    notify-send -a Keyboard -i preferences-desktop-theme "Keyboard" "Rainbow off"
else
    "$BIN/kbd-effect" rainbow
    notify-send -a Keyboard -i preferences-desktop-theme "Keyboard" "Rainbow on"
fi
