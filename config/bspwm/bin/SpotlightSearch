#!/usr/bin/env python3
"""Spotlight (the app menu's Spotlight style): a rofi script mode.

Your apps (the ones you use most first). When what you type isn't an app,
press Enter:
  2+3*4, 15% of 80, sqrt(2)   the answer (Enter copies it)
  /name                       files in your home folder with that name
  anything else               search the web, or find files with that name
"""

import ast
import json
import math
import operator
import os
import re
import subprocess
import sys
import time
import urllib.parse

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio  # noqa: E402

try:
    gi.require_version("GioUnix", "2.0")
    from gi.repository import GioUnix  # noqa: E402
    DesktopAppInfo = GioUnix.DesktopAppInfo
except (ImportError, ValueError):
    DesktopAppInfo = Gio.DesktopAppInfo

HOME = os.path.expanduser("~")
HISTORY = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "control-center",
                       "spotlight-history.json")
WEB = "https://www.google.com/search?q="
SKIP_DIRS = {"node_modules", ".git", ".cache", "Android", "android-sdk", ".gradle", ".local", ".npm", ".cargo",
             ".rustup", "go", ".var", "snap", "__pycache__"}


def row(text, info="", icon="", meta=""):
    parts = [text]
    extra = []
    if icon:
        extra.append(f"icon\x1f{icon}")
    if info:
        extra.append(f"info\x1f{info}")
    if meta:
        extra.append(f"meta\x1f{meta}")
    line = text + ("\0" + "\x1f".join(extra) if extra else "")
    print(line.replace("\0icon\x1f", "\0icon\x1f", 1))


def option(name, value):
    print(f"\0{name}\x1f{value}")


# ----- apps -----

def history():
    try:
        with open(HISTORY) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def used(app_id):
    h = history()
    h[app_id] = h.get(app_id, 0) + 1
    os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
    with open(HISTORY, "w") as f:
        json.dump(h, f)


def icon_of(app):
    icon = app.get_icon()
    if icon is None:
        return "application-x-executable"
    if isinstance(icon, Gio.ThemedIcon):
        return icon.get_names()[0]
    if isinstance(icon, Gio.FileIcon):
        return icon.get_file().get_path() or ""
    return icon.to_string() or ""


def list_apps():
    h = history()
    apps = [a for a in Gio.AppInfo.get_all() if isinstance(a, DesktopAppInfo) and a.should_show()]
    apps.sort(key=lambda a: (-h.get(a.get_id(), 0), a.get_name().lower()))
    for a in apps:
        keywords = " ".join(a.get_keywords() or []) + " " + (a.get_generic_name() or "")
        row(a.get_name(), f"app:{a.get_id()}", icon_of(a), keywords)


# ----- maths -----

OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv,
       ast.Pow: operator.pow, ast.Mod: operator.mod, ast.FloorDiv: operator.floordiv,
       ast.USub: operator.neg, ast.UAdd: operator.pos}
NAMES = {k: getattr(math, k) for k in ("sqrt", "sin", "cos", "tan", "log", "log10", "log2", "exp", "floor", "ceil",
                                       "pi", "e", "radians", "degrees", "factorial")}
NAMES.update(abs=abs, round=round)


def _eval(node):
    if isinstance(node, ast.Expression):
        return _eval(node.body)
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in OPS:
        left, right = _eval(node.left), _eval(node.right)
        if isinstance(node.op, ast.Pow) and abs(right) > 1000:
            raise ValueError("too big")
        return OPS[type(node.op)](left, right)
    if isinstance(node, ast.UnaryOp) and type(node.op) in OPS:
        return OPS[type(node.op)](_eval(node.operand))
    if isinstance(node, ast.Name) and node.id in NAMES and not callable(NAMES[node.id]):
        return NAMES[node.id]
    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in NAMES:
        return NAMES[node.func.id](*[_eval(a) for a in node.args])
    raise ValueError("not maths")


def calc(text):
    t = text.strip().lower().replace("×", "*").replace("÷", "/").replace("^", "**").replace(",", "")
    m = re.fullmatch(r"([\d.]+)\s*%\s*of\s*([\d.]+)", t)
    if m:
        t = f"{m.group(1)}/100*{m.group(2)}"
    t = re.sub(r"([\d.]+)\s*%", r"(\1/100)", t)
    if not re.search(r"\d", t) or not re.fullmatch(r"[\d\s.+\-*/()%a-z_]+", t):
        return None
    try:
        v = _eval(ast.parse(t, mode="eval"))
    except (ValueError, SyntaxError, TypeError, ZeroDivisionError, OverflowError):
        return None
    if isinstance(v, float):
        if v.is_integer() and abs(v) < 1e15:
            v = int(v)
        else:
            v = float(f"{v:.10g}")
    return str(v)


# ----- files -----

def find_files(name, limit=25, seconds=1.5):
    name = name.lower()
    out, start = [], time.monotonic()
    for root, dirs, files in os.walk(HOME):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d not in SKIP_DIRS]
        for f in dirs + files:
            if name in f.lower():
                out.append(os.path.join(root, f))
                if len(out) >= limit:
                    return out
        if time.monotonic() - start > seconds:
            break
    return out


def show_files(name):
    found = find_files(name)
    option("message", f"Files named “{name}”" if found else f"No files named “{name}” in your home folder")
    for p in found:
        row(p.replace(HOME, "~", 1), f"open:{p}", "folder" if os.path.isdir(p) else "text-x-generic")


# ----- what was chosen -----

def detach():
    """Whatever is started from here must not keep rofi's pipe open: rofi waits
    for it to close, with the keyboard grabbed (it looked frozen)."""
    devnull = os.open(os.devnull, os.O_RDWR)
    sys.stdout.flush()
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)


def act(info, text):
    kind, _, value = info.partition(":")
    if kind != "files":             # (files: rofi stays open with the list we print)
        detach()
    if kind == "app":
        app = DesktopAppInfo.new(value)
        if app:
            used(value)
            app.launch([], None)
    elif kind == "copy":
        subprocess.run(["xclip", "-selection", "clipboard"], input=value.encode())
        subprocess.Popen(["notify-send", "-a", "Spotlight", "-i", "accessories-calculator", "Copied", value])
    elif kind == "open":
        subprocess.Popen(["xdg-open", value], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif kind == "web":
        subprocess.Popen(["xdg-open", WEB + urllib.parse.quote(value)], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif kind == "files":
        show_files(value)            # (rofi stays open with the files)


def typed(text):
    """Enter on something that isn't an app."""
    text = text.strip()
    if not text:
        return
    if text.startswith("/") and len(text) > 1:
        show_files(text[1:])
        return
    answer = calc(text)
    if answer is not None:
        option("message", f"{text} = <b>{answer}</b>")
        option("markup-rows", "false")
        row(f"= {answer}   (Enter copies it)", f"copy:{answer}", "accessories-calculator")
        return
    option("message", f"“{text}”")
    row(f"Search the web for “{text}”", f"web:{text}", "web-browser")
    row(f"Find files named “{text}”", f"files:{text}", "system-search")


def main():
    retv = int(os.environ.get("ROFI_RETV", "0"))
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    option("prompt", "Search")
    if retv == 0:
        list_apps()
    elif retv == 1:
        act(os.environ.get("ROFI_INFO", ""), arg)
    elif retv == 2:
        typed(arg)


if __name__ == "__main__":
    main()
