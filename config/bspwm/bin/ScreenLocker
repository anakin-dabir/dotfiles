#!/usr/bin/env bash
# =============================================================
# Date:   23.04.2025
#
# Script Name: ScreenLocker
# Description: Advanced screen locker with blur effect and theme-based wallpapers
# Features:
#   - Dynamic blur effect on screenshot
#   - Themed lockscreen wallpapers
#   - Customizable colors and fonts
#   - Multiple image format support (JPG/PNG/WEBP)
#   - Adaptive to screen resolution (Bye bye hardcoded values!)
#
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Licensed under GPL-3.0 license
# =============================================================
#
# Lock screen: your wallpaper blurred and darkened, a big clock and the date,
# your picture in a circle with your name, and a thin ring around it that
# lights up in the theme's accent colour as you type (red when it's wrong).
#
#   ScreenLocker             lock now
#   ScreenLocker --prepare   make the background ahead of time (locking is instant then)
#   ScreenLocker --preview F write the background to F (Control Center > Power)
#
# Settings (Control Center > Power > Lock screen): config/lock.json
#   {"background": "wallpaper" | "theme" | "screen", "picture": true}
# Your picture: ~/.face, else config/assets/profile.png.

BSPDIR="$HOME/.config/bspwm"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/control-center/lock"
CFG="$BSPDIR/config/lock.json"
TEMP_LAYOUT="/tmp/lockerpreviouskeymap"
mkdir -p "$CACHE"

setting() { jq -r --arg k "$1" --arg d "$2" '.[$k] // $d | tostring' "$CFG" 2>/dev/null || echo "$2"; }

# ----- the theme: accent, red, font -----
read -r RICE < "$BSPDIR/.rice"
THEME="$BSPDIR/rices/$RICE/theme-config.bash"
var() { sed -n "s/^$1=[\"']\\{0,1\\}\\([^\"']*\\)[\"']\\{0,1\\}.*/\\1/p" "$THEME" | head -1; }
ACCENT=$(var FOCUSED_BC); ACCENT=${ACCENT#\#}; ACCENT=${ACCENT:0:6}; [ -n "$ACCENT" ] || ACCENT=0A84FF
RED=$(var red); RED=${RED#\#}; RED=${RED:0:6}; [ -n "$RED" ] || RED=FF453A
FONT=$(var dunst_font); FONT=$(echo "$FONT" | sed 's/ [0-9.]*$//'); [ -n "$FONT" ] || FONT="Sans"

# ----- screen size (the main screen; other screens get the same picture) -----
read -r W H < <(xrandr 2>/dev/null | awk '/ connected primary [0-9]/ { split($4, a, /[x+]/); print a[1], a[2]; exit }')
[ -n "$W" ] || read -r W H < <(xrandr 2>/dev/null | awk '/ connected [0-9]/ { split($3, a, /[x+]/); print a[1], a[2]; exit }')
W=${W:-1920}; H=${H:-1080}

# ----- the background -----
picture_file() { [ -f "$HOME/.face" ] && echo "$HOME/.face" || echo "$BSPDIR/config/assets/profile.png"; }
user_name() {
    local n; n=$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)
    [ -n "$n" ] && echo "$n" || echo "${USER^}"
}

source_image() {
    case "$(setting background wallpaper)" in
        screen) echo "screen" ;;
        theme)  find "$BSPDIR/rices/$RICE/walls" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | shuf -n 1 ;;
        *)      sed -n "s/.*--bg-[a-z]* '\\([^']*\\)'.*/\\1/p" "$HOME/.fehbg" 2>/dev/null | head -1 ;;
    esac
}

make_background() { # src out
    local src=$1 out=$2 pic=$(picture_file) cy=$((H * 58 / 100)) size=150
    local font_file; font_file=$(fc-match -f '%{file}' "$FONT:style=Bold" 2>/dev/null)
    if [ "$src" = screen ]; then maim -u "$CACHE/screen.png" && src="$CACHE/screen.png"; fi
    [ -f "$src" ] || { magick -size "${W}x${H}" "xc:#1c1c1e" "$out"; src=$out; }
    # blur fast: shrink, blur, grow back; then darken a little
    local args=("$src" -resize "${W}x${H}^" -gravity center -extent "${W}x${H}"
                -resize 8% -blur 0x3 -resize "${W}x${H}!" -blur 0x10 -fill black -colorize 45%)
    if [ "$(setting picture true)" = true ] && [ -f "$pic" ]; then
        magick "$pic" -resize "${size}x${size}^" -gravity center -extent "${size}x${size}" \
            \( -size "${size}x${size}" xc:black -fill white -draw "circle $((size / 2)),$((size / 2)) $((size / 2)),0" \) \
            -alpha off -compose CopyOpacity -composite "$CACHE/face.png"
        args+=(-gravity northwest "$CACHE/face.png" -geometry "+$((W / 2 - size / 2))+$((cy - size / 2))" -compose over -composite)
        args+=(-gravity north -fill white -pointsize 20)
        [ -n "$font_file" ] && args+=(-font "$font_file")
        args+=(-annotate "+0+$((cy + size / 2 + 22))" "$(user_name)")
    fi
    magick "${args[@]}" "$out"
}

background() { # prints the path of the background (made now if needed)
    local src key out
    src=$(source_image)
    if [ "$src" = screen ]; then out="$CACHE/screen-lock.png"; make_background screen "$out"; echo "$out"; return; fi
    key=$(printf 'v2 %s %s %s %s %s %s %s' "$src" "$(stat -c %Y "$src" 2>/dev/null)" "$W" "$H" \
          "$(stat -c %Y "$(picture_file)" 2>/dev/null)" "$(setting picture true)" "$(user_name)" | md5sum | cut -c1-16)
    out="$CACHE/$key.png"
    if [ ! -s "$out" ]; then
        find "$CACHE" -name '*.png' ! -name face.png -mmin +1 -delete 2>/dev/null   # (old ones)
        make_background "$src" "$out"
    fi
    echo "$out"
}

# ----- keyboard layout: typed in US while locked, yours back after -----
save_current_keymap() {
    setxkbmap -query | awk '/layout:/ {print $2}' > "$TEMP_LAYOUT"
    setxkbmap -query | awk '/options:/ {print $2}' > "${TEMP_LAYOUT}_options"
}
restore_previous_keymap() {
    [ -f "$TEMP_LAYOUT" ] || return
    if [ -s "${TEMP_LAYOUT}_options" ]; then
        setxkbmap -layout "$(cat "$TEMP_LAYOUT")" -option "" -option "$(cat "${TEMP_LAYOUT}_options")"
    else
        setxkbmap -layout "$(cat "$TEMP_LAYOUT")"
    fi
    rm -f "$TEMP_LAYOUT" "${TEMP_LAYOUT}_options"
}

lock() {
    local img; img=$(background)
    pgrep -x i3lock >/dev/null && return      # (already locked)
    save_current_keymap
    setxkbmap -layout us
    local cy="y+h*0.58" ring=$((150 / 2 + 7))
    i3lock -n -e --force-clock -i "$img" --fill --indicator \
        --time-str="%H:%M" --date-str="%A, %-d %B" \
        --time-font="$FONT:style=Bold" --date-font="$FONT" --greeter-font="$FONT" \
        --verif-font="$FONT" --wrong-font="$FONT" \
        --time-size=104 --date-size=22 --greeter-size=15 --verif-size=15 --wrong-size=15 \
        --time-color=ffffffff --date-color=ffffffcc --greeter-color=ffffff99 \
        --verif-color=ffffffcc --wrong-color="${RED}ff" \
        --time-pos="x+w/2:y+h*0.27" --date-pos="x+w/2:y+h*0.27+46" \
        --ind-pos="x+w/2:$cy" --radius="$ring" --ring-width=4 \
        --greeter-text="Type your password" --verif-text="Checking…" --wrong-text="Wrong password" \
        --noinput-text="" --greeter-pos="x+w/2:$cy+150" --verif-pos="x+w/2:$cy+150" --wrong-pos="x+w/2:$cy+150" \
        --inside-color=00000000 --ring-color=ffffff40 --line-color=00000000 --separator-color=00000000 \
        --keyhl-color="${ACCENT}ff" --bshl-color="${RED}ff" \
        --insidever-color=00000000 --ringver-color="${ACCENT}ff" \
        --insidewrong-color=00000000 --ringwrong-color="${RED}ff" \
        --pointer=default --refresh-rate=1 --pass-media-keys --pass-volume-keys --pass-screen-keys
    restore_previous_keymap
}

case "$1" in
    --prepare) background >/dev/null ;;
    --preview) [ -n "$2" ] && cp "$(background)" "$2" ;;
    -h|--help) sed -n '18,30p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) lock ;;
esac
