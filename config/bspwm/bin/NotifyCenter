#!/usr/bin/env bash
# Notification center: a panel with past notifications (logged by NotifyLog).
#   NotifyCenter             open/close the panel (bar bell, super + alt + i)
#   NotifyCenter --bar       bell for the bars: dot = unread, crossed out = Do Not Disturb
#   NotifyCenter --dnd       toggle Do Not Disturb
#   NotifyCenter --open K    go to the app notification K came from
#   NotifyCenter --delete K  remove notification K
#   NotifyCenter --clear     remove all notifications
#   NotifyCenter --close     close the panel
#   NotifyCenter --refresh   update the bell and the open panel (NotifyLog calls this)

DIR="${XDG_STATE_HOME:-$HOME/.local/state}/notifications"
LOG="$DIR/log.jsonl"
SEEN="$DIR/last-seen"
BSPDIR="$HOME/.config/bspwm"
EWW=(eww -c "$BSPDIR/eww")

PANEL_W=400   # panel width in px (keep in sync with notifications.yuck)
GAP=8         # space between bar and panel
SHOWN=100     # newest notifications listed in the panel

BELL=$'\U000F009C'      # nf-md-bell_outline
BELL_DOT=$'\U000F0178'  # nf-md-bell_badge_outline
BELL_OFF=$'\U000F0A91'  # nf-md-bell_off_outline

mkdir -p "$DIR"; touch "$LOG"

# Entries written before keys existed get one, so they can be opened/deleted.
if grep -qv '"key"' "$LOG"; then
    jq -c '. + {key: (.key // "\(.time)\(input_line_number)")}' "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

is_paused()  { [ "$(dunstctl is-paused 2>/dev/null)" = true ]; }
seen_time()  { cat "$SEEN" 2>/dev/null || echo 0; }
mark_seen()  { date +%s > "$SEEN"; }
panel_open() { "${EWW[@]}" active-windows 2>/dev/null | grep -q 'notifcenter'; }

unread_count() {
    jq -s --argjson seen "$(seen_time)" '[.[] | select(.time > $seen)] | length' "$LOG" 2>/dev/null || echo 0
}

bell() {
    if is_paused; then echo "$BELL_OFF"
    elif [ "$(unread_count)" -gt 0 ]; then echo "$BELL_DOT"
    else echo "$BELL"; fi
}

current_bar() {
    local rice; read -r rice < "$BSPDIR/.rice"
    sed -n 's/^main_bar="\{0,1\}\([^"]*\)"\{0,1\}/\1/p' "$BSPDIR/rices/$rice/theme-config.bash" | head -1
}

refresh_bars() {
    polybar-msg action notifications hook 0 >/dev/null 2>&1
    local bar; bar=$(current_bar)
    if [ -f "$BSPDIR/bars/$bar/eww.yuck" ]; then
        eww -c "$BSPDIR/bars/$bar" update notif_bell="$(bell)" >/dev/null 2>&1
    fi
}

ensure_daemon() {
    "${EWW[@]}" ping >/dev/null 2>&1 && return
    "${EWW[@]}" daemon >/dev/null 2>&1
    for _ in $(seq 20); do "${EWW[@]}" ping >/dev/null 2>&1 && return; sleep 0.1; done
}

# Fill the panel's variables from the log.
push_data() { # $1 = unread threshold (unix time), $2 = max list height in px
    local missing items
    # Icons that no longer exist on disk fall back to a bell glyph
    missing=$(jq -r '.icon // empty' "$LOG" | sort -u |
        while IFS= read -r p; do [ -f "$p" ] || printf '%s\n' "$p"; done | jq -R . | jq -sc .)

    items=$(jq -sc \
        --argjson now "$(date +%s)" --argjson seen "${1:-$(seen_time)}" --argjson max "$SHOWN" \
        --arg today "$(date +%F)" --arg yday "$(date -d yesterday +%F)" \
        --argjson missing "$missing" '
        def clean: gsub("<[^>]*>"; "") | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&quot;"; "\"")
                   | gsub("&apos;|&#39;"; "'"'"'") | gsub("&amp;"; "&") | gsub("\\s+"; " ")
                   | sub("^ "; "") | sub(" $"; "");
        def day: (.time | strflocaltime("%Y-%m-%d")) as $d
                 | if $d == $today then "Today" elif $d == $yday then "Yesterday"
                   else (.time | strflocaltime("%A, %B %-d")) end;
        def ago: ($now - .time) as $s
                 | if $s < 60 then "now" elif $s < 3600 then "\($s / 60 | floor)m ago"
                   elif $s < 6 * 3600 then "\($s / 3600 | floor)h ago"
                   else (.time | strflocaltime("%H:%M")) end;
        reverse | .[:$max]
        | map({key, app: ((.app // "") | if . == "" then "Notification" else . end),
               summary: ((.summary // "") | clean), body: ((.body // "") | clean),
               urgency: (.urgency // "NORMAL"), ago: ago, day: day, unread: (.time > $seen),
               icon: ((.icon // "") as $i | if $i == "" or ($missing | index($i)) then "" else $i end)})
        | map(if .body == .summary then .body = "" else . end)
        | . as $a | [range(length) as $i | $a[$i] + {header: (if $i == 0 or $a[$i - 1].day != $a[$i].day then $a[$i].day else "" end)}]' \
        "$LOG")

    local total unread sub height
    total=$(wc -l < "$LOG")
    unread=$(jq '[.[] | select(.unread)] | length' <<< "$items")
    if [ "$total" -eq 0 ]; then sub="You're all caught up"
    elif [ "$unread" -gt 0 ]; then sub="$unread new · $total saved"
    else sub="$total saved"; fi

    # Rough height of the list so short lists don't leave an empty panel
    height=$(jq '[.[] | 74 + (if .body != "" then 18 else 0 end) + (if .header != "" then 34 else 0 end) + 8] | add // 0' <<< "$items")
    [ -n "$2" ] && echo "$2" > "$DIR/max-height"
    local max; max=$(cat "$DIR/max-height" 2>/dev/null || echo 600)
    [ "$height" -gt "$max" ] && height=$max

    "${EWW[@]}" update nc_items="$items" nc_total="$total" nc_sub="$sub" \
        nc_dnd="$(is_paused && echo true || echo false)" nc_height="$height" >/dev/null 2>&1
}

# Work out where the panel goes: under (or over) the bar, below the bell when
# it was clicked, top-right of the screen when opened from the keyboard.
place_panel() {
    local X Y WINDOW SCREEN mon mx my mw mh
    eval "$(xdotool getmouselocation --shell)"
    read -r mon mx my mw mh < <(bspc query -T -m focused |
        jq -r '"\(.name) \(.rectangle.x) \(.rectangle.y) \(.rectangle.width) \(.rectangle.height)"')

    local bar="" clicked=0 class
    class=$(xprop -id "$WINDOW" WM_CLASS 2>/dev/null)
    if [[ "$class" == *[Pp]olybar* || "$class" == *eww* ]]; then
        bar=$WINDOW; clicked=1
    else
        # Keyboard: use the widest bar on this monitor
        local w g best=0 gx gw
        for w in $(xdotool search --onlyvisible --class 'Polybar' 2>/dev/null) \
                 $(xdotool search --onlyvisible --name '^Eww - bar$' 2>/dev/null); do
            g=$(xdotool getwindowgeometry --shell "$w")
            gx=$(sed -n 's/^X=//p' <<< "$g"); gw=$(sed -n 's/^WIDTH=//p' <<< "$g")
            (( gx < mx || gx >= mx + mw )) && continue
            (( gw > best )) && { best=$gw; bar=$w; }
        done
    fi

    local x y anchor="top left" bx=0 by=0 bw=0 bh=0
    if [ -n "$bar" ]; then
        local g; g=$(xdotool getwindowgeometry --shell "$bar")
        bx=$(sed -n 's/^X=//p' <<< "$g"); by=$(sed -n 's/^Y=//p' <<< "$g")
        bw=$(sed -n 's/^WIDTH=//p' <<< "$g"); bh=$(sed -n 's/^HEIGHT=//p' <<< "$g")
    fi

    local maxh
    if [ -n "$bar" ] && (( bw < bh )); then
        # Vertical bar: open beside it
        (( bx - mx < mw / 2 )) && x=$(( bx + bw + GAP - mx )) || x=$(( bx - PANEL_W - GAP - mx ))
        y=$GAP; maxh=$(( mh - 2 * GAP - 90 ))
    else
        if (( clicked )); then x=$(( X - mx - PANEL_W / 2 )); else x=$(( mw - PANEL_W - GAP )); fi
        if [ -n "$bar" ] && (( by - my > mh / 2 )); then
            anchor="bottom left"; y=$(( -(my + mh - by + GAP) ))
            maxh=$(( by - my - 2 * GAP - 90 ))
        elif [ -n "$bar" ]; then
            y=$(( by + bh - my + GAP )); maxh=$(( mh - bh - 2 * GAP - 90 ))
        else
            y=$(( GAP + 32 )); maxh=$(( mh - 2 * GAP - 122 ))
        fi
    fi
    (( x < GAP )) && x=$GAP
    (( x > mw - PANEL_W - GAP )) && x=$(( mw - PANEL_W - GAP ))
    (( maxh > 640 )) && maxh=640

    echo "$mon ${x}x${y} $anchor|$maxh"
}

open_panel() {
    ensure_daemon
    local placement mon pos anchor maxh
    placement=$(place_panel)
    maxh=${placement##*|}; placement=${placement%|*}
    read -r mon pos anchor <<< "$placement"
    # eww wants the monitor's number, not its name
    mon=$(xrandr --listmonitors | awk -v n="$mon" '$NF == n { sub(":", "", $1); print $1 }')

    push_data "$(seen_time)" "$maxh"
    "${EWW[@]}" update nc_confirm=false >/dev/null 2>&1
    "${EWW[@]}" open nc-closer --screen "$mon" >/dev/null 2>&1
    "${EWW[@]}" open notifcenter --screen "$mon" --pos "$pos" --anchor "$anchor" >/dev/null 2>&1
    mark_seen
    refresh_bars
}

close_panel() {
    "${EWW[@]}" close notifcenter nc-closer >/dev/null 2>&1
    mark_seen
    refresh_bars
}

entry() { jq -c --arg k "$1" 'select(.key == $k)' "$LOG" | head -1; }

# Find a window that belongs to the app (class/instance looks like its name).
find_window() { # $1 = app name, $2 = desktop entry
    local norm cands=() part wid cls
    norm() { tr '[:upper:]' '[:lower:]' <<< "$1" | tr -cd 'a-z0-9'; }
    cands+=("$(norm "$1")" "$(norm "${1%% *}")")
    for part in ${2//./ }; do
        case "$part" in org|com|io|net|app|desktop|github|gitlab) ;; *) cands+=("$(norm "$part")") ;; esac
    done
    for wid in $(bspc query -N -n '.window'); do
        cls=$(norm "$(xprop -id "$wid" WM_CLASS 2>/dev/null | cut -d= -f2)")
        for part in "${cands[@]}"; do
            [ ${#part} -ge 3 ] && [[ "$cls" == *"$part"* ]] && { echo "$wid"; return 0; }
        done
    done
    return 1
}

open_entry() {
    close_panel
    local e app desktop wid url
    e=$(entry "$1"); [ -z "$e" ] && return
    app=$(jq -r '.app // ""' <<< "$e"); desktop=$(jq -r '.desktop // ""' <<< "$e")

    # 1. The app is running: jump to its window
    if wid=$(find_window "$app" "$desktop"); then
        bspc node "$wid" -g hidden=off 2>/dev/null
        bspc node -f "$wid"
        return
    fi
    # 2. Start it
    if [ -n "$desktop" ] && gtk-launch "${desktop%.desktop}" >/dev/null 2>&1; then
        return
    fi
    # 3. It carries a link: open it
    url=$(jq -r '"\(.urls // "") \(.body // "")"' <<< "$e" | grep -oE 'https?://[^ "<>]+' | head -1)
    if [ -n "$url" ]; then
        xdg-open "$url" >/dev/null 2>&1 &
        return
    fi
    # 4. Nothing to open: show it again in full
    jq -r '[.app, .icon, .summary, .body] | map(. // "") | .[]' <<< "$e" | {
        IFS= read -r app; IFS= read -r icon; IFS= read -r summary; body=$(cat)
        notify-send -a "${app:-Notification}" ${icon:+-i "$icon"} \
            -h string:x-dunst-stack-tag:notifycenter "$summary" "$body"
    }
}

delete_entry() {
    jq -c --arg k "$1" 'select(.key != $k)' "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
    panel_open && push_data
    refresh_bars
}

clear_all() {
    # Keep the previous history, in case "Clear" was clicked by mistake
    [ -s "$LOG" ] && cp "$LOG" "$LOG.before-clear"
    : > "$LOG"
    dunstctl history-clear 2>/dev/null
    "${EWW[@]}" update nc_confirm=false >/dev/null 2>&1
    panel_open && push_data
    refresh_bars
}

toggle_dnd() {
    dunstctl set-paused toggle
    panel_open && "${EWW[@]}" update nc_dnd="$(is_paused && echo true || echo false)" >/dev/null 2>&1
    refresh_bars
}

case "$1" in
    --bar)     bell ;;
    --dnd)     toggle_dnd ;;
    --open)    open_entry "$2" ;;
    --delete)  delete_entry "$2" ;;
    --clear)   clear_all ;;
    --close)   close_panel ;;
    --refresh) if panel_open; then push_data; mark_seen; fi; refresh_bars ;;
    *)         if panel_open; then close_panel; else open_panel; fi ;;
esac
