#!/bin/bash
# Set keyboard backlight color. No sudo needed — the RGB zone files are made
# group-writable (wheel) by /etc/udev/rules.d/99-hp-kbd-rgb.rules.
#   --preview RRGGBB : apply only (do NOT save)
#   RRGGBB           : apply AND save to config (permanent)
ZONES=(/sys/devices/platform/hp-wmi/rgb_zones/zone0*)
CONF=/etc/kbd-backlight.conf

PREVIEW=0
[ "$1" = "--preview" ] && { PREVIEW=1; shift; }
HEX="$1"
[[ "$HEX" =~ ^[0-9A-Fa-f]{6}$ ]] || { echo "usage: $0 [--preview] RRGGBB" >&2; exit 1; }
HEX="${HEX^^}"

[ "$PREVIEW" -eq 0 ] && printf '%s\n' "$HEX" > "$CONF" 2>/dev/null
for z in "${ZONES[@]}"; do printf '%s' "$HEX" > "$z" 2>/dev/null; done
