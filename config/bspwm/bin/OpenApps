#!/bin/sh
# =============================================================
# Script to control prefered apps to launch for all themes
# Date:    24.04.2025
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Licensed under GPL-3.0 license
# =============================================================

WIDGET_DIR="$HOME/.config/bspwm/eww"

case "$1" in
	--menu)
		RofiLauncher --launcher
		;;
	--rice)
		RiceSelector
		;;
	--terminal)
		Term --terminal
		;;
	--floating)
		Term --floating
		;;
	--checkupdates)
		Term --checkupdates
		;;
	--netmanager)
		NetManagerDM
		;;
	--pass)
		RofiPass
		;;
	--bluetooth)
		rofi-bluetooth
		;;
	--clipboard)
		clipcat-menu
		;;
	--screenshot)
		ScreenShoTer
		;;
	--powermenu)
		PowerMenu
		;;
	--android)
		AndroidMount
		;;
	--keyboard)
		KeyBoardL
		;;
	--yazi)
		Term --yazi
		;;
	--nvim)
		Term --nvim
		;;
	--music)
		Term --music
		;;
	--fetch)
		Term --fetch
		;;
	--scratch)
		Bspwm-ScratchPad
		;;
		# Apps
	--filemanager)
		thunar
		;;
	--browser)
		google-chrome-stable
		;;
	--editor)
		geany
		;;
	--telegram)
		telegram-desktop
		;;
	--whats)
		firefox -new-tab https://web.whatsapp.com/
		;;
	--soundcontrol)
		pavucontrol
		;;
		# Eww Widgets
	--KeyHelp)
		Help
		;;
	--usercard)
		EwwDaemon && eww -c "$WIDGET_DIR" open --toggle launchermenu
		;;
	--player)
		EwwDaemon && eww -c "$WIDGET_DIR" open --toggle music
		;;
	--calendar)
		EwwDaemon && eww -c "$WIDGET_DIR" open --toggle date
		;;
	--code)
		code dash/
		;;
	--warp)
		warp-cloudflare-gui
		;;
	--xephyr-sandbox)
		"$HOME"/.config/bspwm/bin/sandbox-menu
		;;
	--run-on-nvidia)
		"$HOME"/.config/bspwm/bin/Nvidia
		;;
	--xephyr-sandbox-nvidia)
		"$HOME"/.config/bspwm/bin/sandbox-menu-nvidia
		;;
	--monitor)
		gnome-system-monitor
		;;
	*)
		echo "Invalid Option"
		;;
esac
