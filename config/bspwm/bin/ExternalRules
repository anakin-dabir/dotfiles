#!/usr/bin/env bash
#
#

wid=$1
class=$2
instance=$3
consequences=$4

title=$(
    xprop -id "$wid" _NET_WM_NAME 2>/dev/null |
    sed 's/.*= "\(.*\)"/\1/'
)

[ -n "$title" ] || title=$(
    xprop -id "$wid" WM_NAME 2>/dev/null |
    sed 's/.*= "\(.*\)"/\1/'
)

result() {
    eval "$consequences"
    [ "$state" ] || echo "$1"
}

# eww windows that bspwm manages (the Wi-Fi password box): float, no border;
# BarPanelAction puts them in place (their title isn't set yet here)
if [ "$class" = Eww ]; then
    echo "state=floating focus=on border=off layer=above"
    exit 0
fi

case "$class" in
    FloaTerm)
		result "state=floating center=on rectangle=696x399+0+0"
        ;;
    Updating)
		result "state=floating sticky=on center=on rectangle=390x405+0+0"
        ;;
	Scratch)
		result "state=floating focus=on sticky=on"
		;;
	ControlCenter)
		# Only the main window gets its size (not any dialog window it opens)
		if xprop -id "$wid" _NET_WM_WINDOW_TYPE 2>/dev/null | grep -q _NET_WM_WINDOW_TYPE_DIALOG; then
			result "state=floating focus=on center=on"
		else
			result "state=floating focus=on center=on rectangle=1000x720+0+0"
		fi
		;;
	Xdg-desktop-portal-gtk)
		# "Choose a file/folder" windows that apps open (e.g. Control Center)
		echo "state=floating focus=on center=on rectangle=900x600+0+0"   # (always: bspwm already floats dialogs)
		;;
    mpv)
		result "state=floating focus=on center=on rectangle=723x407+0+0"
        ;;
    Viewnior)
        result "state=floating focus=on center=on"
        ;;
    TelegramDesktop)
        result "desktop=^5 follow=on"
        ;;
    pavucontrol)
        result "state=floating center=on"
        ;;
    firefox|Navigator)
        result "desktop=^6 follow=on"
        ;;
    Brave-browser-beta)
		result "desktop=^1 follow=on"
		;;
	Code)
		result "desktop=^3 follow=on"
		;;
	Google-chrome)
		result "desktop=^2 follow=on"
		;;
	Warpgui)
		result "state=floating focus=on sticky=on rectangle=231x112+1605+55"
		;;
	Io.ente.auth)
		result "state=floating focus=on center=on rectangle=300x300+0+0"
		;;
	gnome-calculator)
		result "state=floating focus=on rectangle=400x600+1505+55"
		;;
	terminal64.exe)
		result "desktop=^10 follow=on"
esac

case "$instance" in
	FloaTerm)
        result "state=floating center=on rectangle=696x399+0+0"
        ;;
    Updating)
        result "state=floating sticky=on center=on rectangle=390x405+0+0"
        ;;
	YaziTerm)
        result "state=floating center=on rectangle=900x342+0+0"
        ;;
	MusicTerm)
        result "state=floating center=on rectangle=656x343+0+0"
        ;;
	FetchTerm)
        result "state=floating center=on rectangle=369x601+0+0"
        ;;
    Toolkit)
        result "state=floating sticky=on rectangle=500x290+1054+593"
        ;;
	YaziTerm)
		result "state=floating center=on rectangle=900x342+0+0"
		;;
	MusicTerm)
		result "state=floating center=on rectangle=656x343+0+0"
		;;
	FetchTerm)
		result "state=floating center=on rectangle=369x601+0+0"
		;;
esac
