#!/usr/bin/env bash
# Buttons and sliders in the bar dropdowns (eww/barpanels) call this.
# Every action updates the dropdown right away instead of waiting for its poll.
#
#   vol-set N | vol-mute | mic-set N | mic-mute | sink NAME
#   bright N | night | night-temp K | night-restore (at login) | awake | power-mode NAME
#   airplane
#   confirm ID ACTION...    first click arms the button ("Sure?"), a second
#                           click within 4 s does ACTION (close apps, clean up)
#   cal prev|next|today|up|down   change the calendar's month (up/down: scroll)
#   close PROCESS           close an app (all its processes)
#   clean-cache | clean-packages | clean-orphans
#   wifi-toggle | bt-toggle | view main|wifi|bt | wifi-scan
#   wifi-connect N (position in the list) | bt-connect MAC
#   run COMMAND...          close the dropdown, then run COMMAND
#   media play|next|prev | media seek PCT
#   clip-copy ID | clip-remove ID | clip-clear
#   weather-refresh
#   win-focus ID | win-close ID | win-show ID (hidden) | win-state floating|fullscreen | win-sticky | win-layout tiled|monocle

BIN="$HOME/.config/bspwm/bin"
RUN="${XDG_RUNTIME_DIR:-/tmp}/barpanel"
SAVED="$HOME/.cache/barpanel"     # kept across restarts
# Night light colour temperature in K (daylight is 6500); Control Center can change it
NIGHT_TEMP=$(cat "$SAVED/nightlight-temp" 2>/dev/null); [[ "$NIGHT_TEMP" =~ ^[0-9]+$ ]] || NIGHT_TEMP=4500
# --no-daemonize: never start a second eww; timeout: a frozen eww can't hang us
EWW=(timeout 3 eww --no-daemonize -c "$HOME/.config/bspwm/eww")
upd()  { "${EWW[@]}" update "$@" >/dev/null 2>&1; }
push() { local p; for p in "$@"; do "$BIN/BarPanelData" "$p" --push; done; }

# Change one field of a dropdown's data at once (sliders: the number next to
# the slider follows while you drag, without re-reading the whole system)
patch() { # var jq-filter
    local cur; cur=$("${EWW[@]}" get "$1" 2>/dev/null) || return
    upd "$1=$(jq -c "$2" <<< "$cur")"
}
int() { printf '%.0f' "$1" 2>/dev/null || echo 0; }

# Switches move the moment they're clicked; the change itself (a radio
# powering up...) can take a second. Until it's done, a "hold" file makes
# the dropdown's own refresh keep showing the new position (BarPanelData).
flip() { # var field value
    mkdir -p "$RUN"; echo "$3" > "$RUN/hold.$1.$2"
    patch "$1" ".$2 = $3"
}
settled() { rm -f "$RUN"/hold.*; }

case "$1" in
    vol-set)  v=$(int "$2"); pamixer --set-volume "$v" --unmute
              patch bp_sound ".vol = $v | .muted = false" ;;
    vol-mute) pamixer -t; push sound ;;
    mic-set)  v=$(int "$2"); pamixer --default-source --set-volume "$v" --unmute
              patch bp_sound ".mic_vol = $v | .mic_muted = false" ;;
    mic-mute) pamixer --default-source -t; push sound ;;
    sink)     pactl set-default-sink "$2"; push sound ;;

    bright)   v=$(int "$2"); (( v < 1 )) && v=1
              brightnessctl -q set "$v%"; patch bp_battery ".bright = $v" ;;

    # Warmer screen colours (stays on after a restart: bspwmrc runs night-restore)
    night)
        if [ -f "$SAVED/nightlight" ]; then
            flip bp_battery night false
            rm -f "$SAVED/nightlight"; redshift -x >/dev/null 2>&1
        else
            flip bp_battery night true
            mkdir -p "$SAVED"; touch "$SAVED/nightlight"; redshift -P -O "$NIGHT_TEMP" >/dev/null 2>&1
        fi
        settled ;;
    night-temp)   # how warm (K); applied right away if night light is on
        t=$(int "$2"); (( t < 1000 )) && t=1000; (( t > 6500 )) && t=6500
        mkdir -p "$SAVED"; echo "$t" > "$SAVED/nightlight-temp"
        [ -f "$SAVED/nightlight" ] && redshift -P -O "$t" >/dev/null 2>&1 ;;
    night-restore)
        [ -f "$SAVED/nightlight" ] && redshift -P -O "$NIGHT_TEMP" >/dev/null 2>&1 ;;

    # Keep awake: the laptop doesn't sleep, not even with the lid closed,
    # until this is turned off again (or you log out)
    awake)
        pid=$(cat "$RUN/awake.pid" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            flip bp_battery awake false
            kill -- "-$pid" 2>/dev/null; rm -f "$RUN/awake.pid"
        else
            flip bp_battery awake true
            setsid systemd-inhibit --what=sleep:idle:handle-lid-switch --mode=block \
                --who="Keep awake" --why="Turned on in the battery menu" sleep infinity \
                >/dev/null 2>&1 < /dev/null 7>&- 8>&- 9>&- &
            echo $! > "$RUN/awake.pid"
        fi
        settled ;;

    power-mode)
        flip bp_battery profile "\"$2\""
        "$BIN/PowerMode" "$2"; settled; push battery ;;   # (goes back if it didn't work)

    # Airplane mode: switch off every radio; turning it off brings back the
    # ones that were on before
    airplane)
        if rfkill -rn -o SOFT | grep -qvx blocked; then
            flip bp_network airplane true; flip bp_network wifi_on false; flip bp_network bt_on false
            mkdir -p "$SAVED"
            { [ "$(nmcli radio wifi)" = enabled ] && echo wifi
              bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo bluetooth; } > "$SAVED/airplane-before"
            rfkill block all
        else
            before=$(cat "$SAVED/airplane-before" 2>/dev/null || printf 'wifi\nbluetooth\n')
            flip bp_network airplane false
            grep -qx wifi <<< "$before" && flip bp_network wifi_on true
            grep -qx bluetooth <<< "$before" && flip bp_network bt_on true
            rfkill unblock all
            grep -qx wifi <<< "$before" && nmcli radio wifi on || nmcli radio wifi off
            sleep 1
            if grep -qx bluetooth <<< "$before"; then bluetoothctl power on; else bluetoothctl power off; fi >/dev/null 2>&1
        fi
        settled; push network ;;

    wifi-toggle)
        if [ "$(nmcli radio wifi)" = enabled ]; then
            flip bp_network wifi_on false; nmcli radio wifi off
        else
            flip bp_network wifi_on true; nmcli radio wifi on
        fi
        settled; push network; sleep 3; push network wifi ;;   # (networks show up after a few seconds)
    bt-toggle)
        if bluetoothctl show | grep -q 'Powered: yes'; then
            flip bp_network bt_on false; bluetoothctl power off
        else
            flip bp_network bt_on true; bluetoothctl power on
        fi >/dev/null 2>&1
        settled; push network bt ;;

    confirm)
        id=$2; shift 2
        if [ "$("${EWW[@]}" get bp_confirm 2>/dev/null)" = "$id" ]; then
            upd bp_confirm=""
            exec "$0" "$@"
        fi
        upd bp_confirm="$id"
        sleep 4
        [ "$("${EWW[@]}" get bp_confirm 2>/dev/null)" = "$id" ] && upd bp_confirm="" ;;

    cal)
        cur=$("${EWW[@]}" get bp_calendar 2>/dev/null | jq -r '.offset // 0')
        case "$2" in
            prev|up)    off=$(( cur - 1 )) ;;
            next|down)  off=$(( cur + 1 )) ;;
            *)          off=0 ;;
        esac
        CAL_OFFSET=$off "$BIN/BarPanelData" calendar --push ;;

    close)      # an app from the CPU/Memory dropdown (never the desktop's own processes)
        [ "$("$BIN/BarPanelData" closable "$2" 2>/dev/null)" = false ] && exit 1
        pkill -TERM -x -- "$2"
        sleep 1.5; push memory; "$BIN/BarPanelData" cpu --fast --push ;;

    clean-cache)    # ~/.cache: thumbnails, browser and app caches (apps rebuild them)
        before=$(du -sb "$HOME/.cache" 2>/dev/null | cut -f1)
        find "$HOME/.cache" -mindepth 1 -maxdepth 1 ! -name "control-center" -exec rm -rf {} + 2>/dev/null
        after=$(du -sb "$HOME/.cache" 2>/dev/null | cut -f1)
        notify-send -a "Storage" -i edit-clear "Caches cleared" \
            "$(numfmt --to=iec --suffix=B $(( ${before:-0} - ${after:-0} ))) freed"
        rm -f "$RUN/clean.txt"; push disk ;;

    clean-packages) # downloaded package files pacman keeps after installing
        before=$(du -sb /var/cache/pacman/pkg 2>/dev/null | cut -f1)
        pkexec sh -c 'paccache -rk0; paccache -ruk0' >/dev/null 2>&1 || { rm -f "$RUN/clean.txt"; push disk; exit 0; }
        after=$(du -sb /var/cache/pacman/pkg 2>/dev/null | cut -f1)
        notify-send -a "Storage" -i edit-clear "Package cache cleared" \
            "$(numfmt --to=iec --suffix=B $(( ${before:-0} - ${after:-0} ))) freed"
        rm -f "$RUN/clean.txt"; push disk ;;

    clean-orphans)  # packages installed as dependencies that nothing needs any more
        mapfile -t orphans < <(pacman -Qdtq 2>/dev/null)
        [ "${#orphans[@]}" -gt 0 ] || exit 0
        if pkexec pacman -Rns --noconfirm "${orphans[@]}" >/dev/null 2>&1; then
            notify-send -a "Storage" -i edit-clear "Removed ${#orphans[@]} unused package(s)" "${orphans[*]}"
        fi
        rm -f "$RUN/clean.txt"; push disk ;;

    view)
        # Fill the list before showing it (networks from the last scan), so
        # the view opens complete instead of filling in while you watch
        case "$2" in
            wifi) push wifi ;;
            bt)   push bt ;;
        esac
        upd bp_view="$2"
        [ "$2" = wifi ] && exec "$0" wifi-scan ;;
    wifi-scan)
        upd bp_scanning=true
        "$BIN/BarPanelData" wifi --rescan --push
        upd bp_scanning=false ;;

    wifi-pass)      # the password was typed in the password box
        ssid=$("${EWW[@]}" get bp_ask_ssid)
        [ -n "$ssid" ] || exit 1
        pass=$(head -n 1 "$RUN/wifi-pass" 2>/dev/null)
        if [ ${#pass} -lt 8 ]; then
            upd bp_ask_err="Wi-Fi passwords have at least 8 characters"; exit 0
        fi
        [ -n "$("${EWW[@]}" get bp_connecting)" ] && exit 0      # (already trying)
        upd bp_ask_err="" bp_connecting="$ssid"
        push wifi
        out=$(nmcli dev wifi connect "$ssid" password "$pass" 2>&1); rc=$?
        rm -f "$RUN/wifi-pass"; pass=""
        upd bp_connecting=""
        if [ $rc -eq 0 ]; then
            date +%s%N > "$RUN/pass-closed"           # (the dropdown stays open)
            "${EWW[@]}" close bp-wifi-pass >/dev/null 2>&1
            upd bp_ask="" bp_ask_ssid="" bp_pass_ok=false
        else
            # (a wrong password leaves a half-made connection behind: remove it)
            nmcli -t -f NAME con show | grep -qxF "$ssid" && ! nmcli -t -f NAME con show --active | grep -qxF "$ssid" &&
                nmcli con delete id "$ssid" >/dev/null 2>&1
            msg=$(tail -n 1 <<< "$out" | sed 's/^Error: //')
            case "$msg" in *[Ss]ecrets*|*password*|*802-11-wireless-security*) msg="Wrong password. Try again." ;; esac
            upd bp_ask_err="$msg"
        fi
        push wifi network ;;

    wifi-ask-cancel)
        rm -f "$RUN/wifi-pass"; date +%s%N > "$RUN/pass-closed"
        "${EWW[@]}" close bp-wifi-pass >/dev/null 2>&1
        upd bp_ask="" bp_ask_ssid="" bp_ask_err="" bp_pass_ok=false ;;

    wifi-connect) # $2 = position in the dropdown's list (names can contain quotes)
        info=$("${EWW[@]}" get bp_wifi | jq -c --argjson i "$2" '.networks[$i]')
        ssid=$(jq -r .ssid <<< "$info")
        [ -z "$ssid" ] || [ "$ssid" = null ] && exit 1
        [ "$(jq -r .active <<< "$info")" = true ] && exit 0
        if [ "$(jq -r .known <<< "$info")" = true ]; then
            upd bp_connecting="$ssid"
            out=$(nmcli con up id "$ssid" 2>&1)
        elif [ "$(jq -r .secure <<< "$info")" = true ]; then
            # Ask for the password in the dropdown (wifi-pass connects)
            rm -f "$RUN/wifi-pass"
            upd bp_ask="$2" bp_ask_ssid="$ssid" bp_ask_err="" bp_pass_ok=false
            # right under the dropdown, attached to it (the dropdown always stays on
            # top, so the box can't cover it); beside it when there's no room below.
            # (eww places it: it moves it back if anything else does)
            dd=$(xdotool search --onlyvisible --name '^Eww - bp-network$' 2>/dev/null | head -1)
            pos=""
            if [ -n "$dd" ]; then
                eval "$(xdotool getwindowgeometry --shell "$dd" | sed 's/^/D_/')"
                read -r SW SH < <(xdotool getdisplaygeometry)
                px=$D_X; py=$(( D_Y + D_HEIGHT + 6 ))
                if [ $(( py + 160 )) -gt "$SH" ]; then
                    py=$(( D_Y + D_HEIGHT - 153 ))
                    px=$(( D_X - 340 - 8 )); [ "$px" -lt 0 ] && px=$(( D_X + D_WIDTH + 8 ))
                fi
                pos="--pos ${px}x${py}"
            fi
            "${EWW[@]}" open bp-wifi-pass $pos --anchor "top left" >/dev/null 2>&1
            for _ in $(seq 30); do
                pw=$(xdotool search --onlyvisible --name '^Eww - bp-wifi-pass$' 2>/dev/null | head -1)
                [ -n "$pw" ] && break; sleep 0.03
            done
            [ -n "$pw" ] && xdotool windowfocus "$pw" 2>/dev/null
            exit 0
        else
            upd bp_connecting="$ssid"
            out=$(nmcli dev wifi connect "$ssid" 2>&1)
        fi
        rc=$?
        upd bp_connecting=""
        [ $rc -ne 0 ] && notify-send -u normal -i network-wireless "Couldn't connect to $ssid" \
            "$(tail -n 1 <<< "$out" | sed 's/^Error: //')"
        push wifi network ;;

    bt-connect)
        mac=$2
        upd bp_connecting="$mac"
        if bluetoothctl info "$mac" | grep -q 'Connected: yes'; then
            bluetoothctl disconnect "$mac" >/dev/null 2>&1
        else
            bluetoothctl power on >/dev/null 2>&1
            timeout 15 bluetoothctl connect "$mac" >/dev/null 2>&1 ||
                notify-send -u normal -i bluetooth "Couldn't connect" "$(bluetoothctl info "$mac" | sed -n 's/^\s*Name: //p') didn't answer. Is it nearby and turned on?"
        fi
        upd bp_connecting=""
        push bt network ;;

    media)          # the player that the dropdown shows (playing one first)
        player=$(playerctl -a metadata --format '{{playerName}} {{status}}' 2>/dev/null |
                 awk '$2 == "Playing" { print $1; found = 1; exit } NR == 1 { first = $1 } END { if (!found) print first }')
        p=(playerctl ${player:+-p "$player"})
        case "$2" in
            play) "${p[@]}" play-pause ;;
            next) "${p[@]}" next ;;
            prev) "${p[@]}" previous ;;
            seek)
                len=$("${p[@]}" metadata mpris:length 2>/dev/null)
                [[ "$len" =~ ^[0-9]+$ && "$3" =~ ^[0-9.]+$ ]] &&
                    "${p[@]}" position "$(awk -v l="$len" -v p="$3" 'BEGIN { printf "%.1f", l / 1000000 * p / 100 }')" ;;
        esac
        sleep 0.15; push media ;;

    clip-copy)      # put an older copy back on the clipboard
        clipcatctl promote "$2" >/dev/null 2>&1
        "$BIN/BarPanel" --close ;;
    clip-remove) clipcatctl remove "$2" >/dev/null 2>&1; push clipboard ;;
    clip-clear)  clipcatctl clear >/dev/null 2>&1; push clipboard ;;

    # Windows dropdown (the bar's window title). The dropdown never takes the
    # focus, so "focused" is the window you were using.
    win-focus)  bspc node "$2" -f; "$BIN/BarPanel" --close ;;
    win-close)  bspc node "$2" -c; sleep 0.3; push windows ;;
    win-show)   bspc node "$2" -g hidden=off; bspc node "$2" -f; push windows ;;
    win-state)  bspc node focused.window -t "~$2"; sleep 0.1; push windows ;;
    win-sticky) bspc node focused.window -g sticky; push windows ;;
    win-layout) "$BIN/Layout" set "$2"; sleep 0.1; push windows ;;

    weather-refresh)
        rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/barpanel-weather/forecast.json"
        push weather ;;

    run)
        shift
        "$BIN/BarPanel" --close
        setsid "$@" >/dev/null 2>&1 < /dev/null & ;;

    *) sed -n '2,18p' "$0" >&2; exit 1 ;;
esac
