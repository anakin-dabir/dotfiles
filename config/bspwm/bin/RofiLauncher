#!/bin/sh
# =============================================================
# Date:   27.06.2025 12:30:38
#
# Script Name: RofiLauncher
# Description: Dynamic theme selector and launcher for Rofi
#
# Copyright (C) 2021-2026 gh0stzk <z0mbi3.zk@protonmail.com>
# Licensed under GPL-3.0 license
# =============================================================

# Main vars
cfgStyle="$HOME/.config/bspwm/config/.launcher"
[ -f "$cfgStyle" ] || echo "1" > "$cfgStyle"
read -r current_style < "$cfgStyle"

# Paths
styleDir="$HOME/.config/bspwm/config/rofi-themes"
rofiAssetDir="$HOME/.config/bspwm/config/assets"

# Each theme can have its own style (LAUNCHER_STYLE in its theme-config.bash,
# set from Control Center > Customize > App menu); otherwise the one above
read -r rice < "$HOME/.config/bspwm/.rice"
themeCfg="$HOME/.config/bspwm/rices/$rice/theme-config.bash"
theme_style=$(sed -n 's/^LAUNCHER_STYLE="\{0,1\}\([0-9][0-9]*\)"\{0,1\}.*/\1/p' "$themeCfg" 2>/dev/null | tail -n 1)
[ -n "$theme_style" ] && [ -f "$styleDir/style_$theme_style.rasi" ] && current_style=$theme_style
[ -f "$styleDir/style_$current_style.rasi" ] || current_style=1

# Function to select the styles
choose_launcher_style() {

    # Find styles
    styles=$(find "$styleDir" -type f -name 'style_*.rasi' | sed 's|.*/style_\([0-9]*\)\.rasi|\1|' | sort -n)

    # Find current style
    selected_index=-1
    index=0
    IFS='
'
    for style in $styles; do
        if [ "$style" = "$current_style" ]; then
            selected_index=$index
            break
        fi
        index=$((index + 1))
    done
    unset IFS

    # Show the rofi selection menu
    selected=$(
    IFS='
'
    for style in $styles; do
        printf "%s\000icon\037%s/style_%s.webp\n" "$style" "$rofiAssetDir" "$style"
    done | rofi -dmenu \
                -theme "$styleDir/StyleSelect.rasi" \
                -selected-row "$selected_index"
    )

    # Remember it for this theme
    [ -n "$selected" ] || return
    if grep -q '^LAUNCHER_STYLE=' "$themeCfg" 2>/dev/null; then
        sed -i "s/^LAUNCHER_STYLE=.*/LAUNCHER_STYLE=\"$selected\"/" "$themeCfg"
    elif [ -f "$themeCfg" ]; then
        printf '\n# App menu style (config/rofi-themes/style_N.rasi)\nLAUNCHER_STYLE="%s"\n' "$selected" >> "$themeCfg"
    else
        echo "$selected" > "$cfgStyle"
    fi

}

launch_launcher () {
    ROFI_THEME="$styleDir/style_$current_style.rasi"
    rofi -show drun -theme "$ROFI_THEME"
}

# -- Main executor -- #
case "$1" in
    --choose-style)
        choose_launcher_style ;;
    --launcher | *)
        launch_launcher ;;
esac
