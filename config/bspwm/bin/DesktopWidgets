#!/usr/bin/env bash
# Desktop widgets (eww/desktop): clock, now playing, weather, calendar,
# system - cards on the desktop, under every window. From config/widgets.json:
#   {"order": [...], "on": {"clock": true, ...}, "style": "cards"|"clear", "corner": "top left"}
# Run at login (bspwmrc) and by Control Center after a change.

BSPDIR="$HOME/.config/bspwm"
EWW=(timeout 3 eww --no-daemonize -c "$BSPDIR/eww")
CFG="$BSPDIR/config/widgets.json"
[ -s "$CFG" ] || exit 0
"$BSPDIR/bin/EwwDaemon" >/dev/null 2>&1

show=$(jq -c '{order: (.order // ["clock","media","weather","calendar","system"]),
               on: (.on // {clock: true}), style: (.style // "cards")}' "$CFG")
corner=$(jq -r '.corner // "top left"' "$CFG")
"${EWW[@]}" close desktop >/dev/null 2>&1
"${EWW[@]}" update "dw_show=$show" >/dev/null 2>&1
[ "$(jq -r '.on | to_entries | any(.value)' <<< "$show")" = true ] || exit 0
case "$corner" in
    "top right"|"top left") pos="40x60" ;;
    *) pos="40x50" ;;
esac
"${EWW[@]}" open desktop --screen 0 --anchor "$corner" --pos "$pos" >/dev/null 2>&1
exit 0
