#!/usr/bin/env bash
# The laptop's power mode (ACPI platform profile, e.g. cool / quiet /
# balanced / performance: how hard the fans and processor may work).
#
#   PowerMode            print the current mode
#   PowerMode --list     print the modes this laptop has
#   PowerMode NAME       switch to NAME
#   PowerMode --setup    one-time: let your user switch modes (asks for the
#                        password; install.sh does this on new installs)
#
# Note: TLP sets its own mode when the charger is plugged in or out.

F=/sys/firmware/acpi/platform_profile
DOTS=$(cd "$(dirname "$(realpath "$0")")/../../.." && pwd)
RULE=etc/tmpfiles.d/platform-profile.conf

case "$1" in
    "")      cat "$F" 2>/dev/null ;;
    --list)  cat "${F}_choices" 2>/dev/null ;;
    --setup)
        [ "$(id -u)" -eq 0 ] || exec pkexec "$(realpath "$0")" --setup
        install -Dm644 "$DOTS/misc/system/common/$RULE" "/$RULE" &&
            systemd-tmpfiles --create "/$RULE" ;;
    *)
        grep -qw -- "$1" "${F}_choices" 2>/dev/null || { echo "No power mode \"$1\"" >&2; exit 2; }
        [ -w "$F" ] || { echo "Not allowed yet: run PowerMode --setup once" >&2; exit 3; }
        echo "$1" > "$F" ;;
esac
