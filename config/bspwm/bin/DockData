#!/usr/bin/env python3
"""The dock's apps (eww/dock): your pinned apps, then other running apps.
Prints one JSON list; with --listen, a new one each time windows change
(bspc subscribe), for eww's deflisten.

Each app: {"id", "name", "icon" (file), "running", "focused", "pinned", "wid"}
Pinned apps: config/dock.json {"pinned": ["firefox.desktop", ...]}
"""

import json
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, Gtk  # noqa: E402

try:
    gi.require_version("GioUnix", "2.0")
    from gi.repository import GioUnix  # noqa: E402
    DesktopAppInfo = GioUnix.DesktopAppInfo
except (ImportError, ValueError):
    DesktopAppInfo = Gio.DesktopAppInfo

CFG = os.path.expanduser("~/.config/bspwm/config/dock.json")
SIZE = 48
_theme = None
_icons = {}
_apps = None


def theme():
    global _theme
    if _theme is None:
        _theme = Gtk.IconTheme.get_default()
    return _theme


def icon_file(app):
    """The app's icon as a file (eww shows files)."""
    key = app.get_id()
    if key in _icons:
        return _icons[key]
    path = ""
    icon = app.get_icon()
    if isinstance(icon, Gio.FileIcon):
        path = icon.get_file().get_path() or ""
    elif isinstance(icon, Gio.ThemedIcon):
        info = theme().choose_icon(icon.get_names(), SIZE, Gtk.IconLookupFlags.FORCE_SIZE)
        path = info.get_filename() if info else ""
    if not path:
        info = theme().lookup_icon("application-x-executable", SIZE, 0)
        path = info.get_filename() if info else ""
    _icons[key] = path
    return path


def apps():
    global _apps
    if _apps is None:
        _apps = [a for a in Gio.AppInfo.get_all() if isinstance(a, DesktopAppInfo)]
    return _apps


def app_for_class(cls):
    low = cls.lower()
    for a in apps():
        wm = (a.get_startup_wm_class() or "").lower()
        aid = (a.get_id() or "").lower().removesuffix(".desktop")
        exe = os.path.basename((a.get_executable() or "")).lower()
        if low in (wm, aid, exe) or (aid and aid.split(".")[-1] == low):
            return a
    return None


def pinned():
    try:
        with open(CFG) as f:
            return list(json.load(f).get("pinned", []))
    except (OSError, ValueError):
        return []


def run(argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def windows():
    """[(window id, class)] of the open windows, and the focused one."""
    out = []
    for wid in run(["bspc", "query", "-N", "-n", ".window"]).split():
        line = run(["xprop", "-id", wid, "WM_CLASS"])
        parts = line.split('"')
        if len(parts) >= 4:
            out.append((wid, parts[3]))
    focused = run(["bspc", "query", "-N", "-n", "focused.window"]).strip()
    return out, focused


SKIP = {"Polybar", "Eww", "ControlCenter-tray"}


def items():
    wins, focused = windows()
    running = {}                 # app id -> [window ids]
    names = {}
    for wid, cls in wins:
        if cls in SKIP:
            continue
        a = app_for_class(cls)
        key = a.get_id() if a else f"class:{cls}"
        running.setdefault(key, []).append(wid)
        if a:
            names[key] = a
    out = []
    for pid in pinned() + [k for k in running if k not in pinned()]:
        a = names.get(pid) or (DesktopAppInfo.new(pid) if not pid.startswith("class:") else None)
        if a is None and pid.startswith("class:"):
            info = theme().lookup_icon("application-x-executable", SIZE, 0)
            out.append({"id": pid, "name": pid[6:], "icon": info.get_filename() if info else "",
                        "running": True, "focused": focused in running.get(pid, []), "pinned": False,
                        "wid": running[pid][0]})
            continue
        if a is None:
            continue
        wids = running.get(pid, [])
        out.append({"id": pid, "name": a.get_name(), "icon": icon_file(a), "running": bool(wids),
                    "focused": focused in wids, "pinned": pid in pinned(), "wid": wids[0] if wids else ""})
    return out


def main():
    if "--listen" not in sys.argv:
        print(json.dumps(items()))
        return
    print(json.dumps(items()), flush=True)
    last = None
    proc = subprocess.Popen(["bspc", "subscribe", "node_add", "node_remove", "node_focus", "node_transfer",
                             "desktop_focus"], stdout=subprocess.PIPE, text=True)
    for _ in proc.stdout:
        now = json.dumps(items())
        if now != last:
            last = now
            print(now, flush=True)


if __name__ == "__main__":
    main()
