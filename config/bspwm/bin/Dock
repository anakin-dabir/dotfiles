#!/usr/bin/env bash
# The dock on or off (config/dock.json "on"); windows keep clear of it
# ("reserve": the bottom padding grows by its height). Run at login and by
# Control Center.

BSPDIR="$HOME/.config/bspwm"
EWW=(timeout 3 eww --no-daemonize -c "$BSPDIR/eww")
CFG="$BSPDIR/config/dock.json"
read -r RICE < "$BSPDIR/.rice"
base=$(sed -n 's/^BOTTOM_PADDING="\{0,1\}\([0-9]*\)"\{0,1\}.*/\1/p' "$BSPDIR/rices/$RICE/theme-config.bash" | head -1)
base=${base:-0}

if [ "$(jq -r '.on // false' "$CFG" 2>/dev/null)" = true ]; then
    "$BSPDIR/bin/EwwDaemon" >/dev/null 2>&1
    "${EWW[@]}" open dock --screen 0 >/dev/null 2>&1
    # its height, as drawn (+ its gap to the screen edge)
    HEIGHT=0
    for _ in $(seq 20); do
        w=$(xdotool search --onlyvisible --name '^Eww - dock$' 2>/dev/null | head -1)
        [ -n "$w" ] && HEIGHT=$(xdotool getwindowgeometry --shell "$w" | sed -n 's/^HEIGHT=//p') && break
        sleep 0.1
    done
    HEIGHT=$(( ${HEIGHT:-0} > 0 ? HEIGHT + 10 : 96 ))
    if [ "$(jq -r '.reserve // true' "$CFG")" = true ]; then
        bspc config -m primary bottom_padding $((base + HEIGHT)) 2>/dev/null || bspc config bottom_padding $((base + HEIGHT))
    fi
else
    "${EWW[@]}" close dock >/dev/null 2>&1
    bspc config -m primary bottom_padding "$base" 2>/dev/null || bspc config bottom_padding "$base"
fi
exit 0
