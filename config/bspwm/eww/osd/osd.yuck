;; On-screen pop-up for volume, brightness and keyboard layout (bin/OSD).
;; A pill that fills with the accent colour up to the level, the icon and the
;; value on top; near the bottom of the screen, gone 1.5 s after the last change.

(defvar osd '{"icon":"","value":0,"text":"","bar":true,"off":false}')

(defwidget osd-box []
  (overlay :class "osd ${osd.off ? 'osd-off' : ''} ${osd.bar ? '' : 'osd-plain'}"
    (progress :class "osd-fill" :value {osd.bar ? osd.value : 0} :orientation "h")
    (box :class "osd-content" :space-evenly false :spacing 12
      (label :class "osd-icon" :valign "center" :text {osd.icon})
      (label :class "osd-text" :valign "center" :halign "start" :hexpand true :xalign 0 :limit-width 24
             :text {osd.bar ? "" : osd.text})
      (label :class "osd-value" :valign "center" :visible {osd.bar}
             :text {osd.off ? "Off" : "${osd.value}%"}))))

(defwindow osd
  :geometry (geometry :x "0px" :y "-90px" :width "300px" :anchor "bottom center")
  :stacking "overlay"
  :wm-ignore true
  :focusable false
  :resizable false
  (osd-box))
