;; Dropdowns under the bar items. Opened, placed and closed by bin/BarPanel;
;; data from bin/BarPanelData (polled only while open), buttons and sliders
;; call bin/BarPanelAction. Look: barpanels.scss, colors/shape from the rice.
;;
;; Layout system (keep it uniform): panel padding 16, 12 between blocks,
;; cards with 12 padding and their title inside, an action button at the end.

(defvar bp_open "")          ;; open dropdown (BarPanel sets it)
(defvar bp_view "main")      ;; network dropdown: main | wifi | bt
(defvar bp_scanning false)   ;; looking for Wi-Fi networks
(defvar bp_connecting "")
(defvar bp_ask "")            ;; Wi-Fi list: the network (position) asking for its password
(defvar bp_ask_err "")        ;; ...and why the last try failed
(defvar bp_ask_ssid "")       ;; ...and its name
(defvar bp_pass_ok false)     ;; ...long enough to try (8+ characters)
(defvar bp_pass_show false)   ;; ...shown as text (the eye) or as dots
(defvar bp_confirm "")
(defvar bp_calendar '{"title":"","offset":0,"weekdays":[],"weeks":[]}')   ;; the month shown (BarPanelData calendar)       ;; a button waiting for its second click ("Sure?")    ;; Wi-Fi name or Bluetooth address being connected
;; The Wi-Fi and Bluetooth lists refresh while they're on screen (no new
;; Wi-Fi search each time: that takes seconds, the refresh button does it)
(defpoll bp_wifi :interval "3s" :run-while {bp_open == "network" && bp_view == "wifi"}
  :initial '{"networks":[]}'
  `~/.config/bspwm/bin/BarPanelData wifi`)
(defpoll bp_bt :interval "3s" :run-while {bp_open == "network" && bp_view == "bt"}
  :initial '{"devices":[]}'
  `~/.config/bspwm/bin/BarPanelData bt`)

(defpoll bp_cpu :interval "2s" :run-while {bp_open == "cpu"}
  :initial '{"total":0,"cores":[],"temp":"","load":"","model":"","procs":[],"threads":0}'
  `~/.config/bspwm/bin/BarPanelData cpu`)
(defpoll bp_memory :interval "2s" :run-while {bp_open == "memory"}
  :initial '{"used":"","total":"","free":"","pct":0,"swap_used":"","swap_total":"","swap_pct":0,"apps":[]}'
  `~/.config/bspwm/bin/BarPanelData memory`)
(defpoll bp_disk :interval "30s" :run-while {bp_open == "disk"}
  :initial '{"disks":[]}'
  `~/.config/bspwm/bin/BarPanelData disk`)
(defpoll bp_sound :interval "2s" :run-while {bp_open == "sound"}
  :initial '{"vol":0,"muted":false,"mic_vol":0,"mic_muted":false,"sinks":[],"output":""}'
  `~/.config/bspwm/bin/BarPanelData sound`)
(defpoll bp_network :interval "2s" :run-while {bp_open == "network"}
  :initial '{"kind":"none","name":"","signal":0,"ip":"","iface":"","down":"","up":"","down_b":0,"wifi_on":false,"bt_on":false,"bt_dev":"","airplane":false}'
  `~/.config/bspwm/bin/BarPanelData network`)
(defpoll bp_battery :interval "2s" :run-while {bp_open == "battery"}
  :initial '{"pct":0,"status":"","time":"","bright":0,"night_temp":4500,"profile":"","profiles":[],"can_profile":false,"night":false,"awake":false}'
  `~/.config/bspwm/bin/BarPanelData battery`)

;; Which sections each dropdown shows (Control Center > Dropdowns; BarPanel
;; loads config/dropdowns.json when a dropdown opens)
(defvar bp_show '{"cpu_graph":true,"cpu_stats":true,"cpu_apps":true,"cpu_button":true,"memory_graph":true,"memory_apps":true,"memory_button":true,"disk_clean":true,"disk_buttons":true,"sound_volume":true,"sound_output":true,"sound_mic":true,"sound_button":true,"network_speed":true,"network_airplane":true,"network_wifi":true,"network_bluetooth":true,"network_button":true,"battery_mode":true,"battery_brightness":true,"battery_night":true,"battery_awake":true,"battery_buttons":true,"network_rows":true,"battery_toggles":true,"order":{"cpu":["cpu_graph","cpu_stats","cpu_apps","cpu_button"],"memory":["memory_graph","memory_apps","memory_button"],"disk":["disk_clean","disk_buttons"],"sound":["sound_volume","sound_output","sound_mic","sound_button"],"network":["network_speed","network_rows","network_button"],"network_rows":["network_airplane","network_wifi","network_bluetooth"],"battery":["battery_mode","battery_brightness","battery_toggles","battery_buttons"],"battery_toggles":["battery_night","battery_awake"]},"first":{"network_rows":"network_airplane","battery_toggles":"battery_night"},"any":{"cpu":true,"memory":true,"disk":true,"sound":true,"network":true,"battery":true}}')

;; ================= building blocks =================

(defwidget bp-head [icon title value ?sub]
  (box :class "bp-head" :space-evenly false :spacing 12
    (label :class "bp-head-icon" :valign "center" :text icon)
    (box :orientation "v" :space-evenly false :hexpand true :valign "center"
      (label :class "bp-title" :halign "start" :xalign 0 :limit-width 24 :text title)
      (label :class "bp-sub" :halign "start" :xalign 0 :limit-width 36 :visible {sub != ""} :text sub))
    (label :class "bp-big" :valign "center" :text value)))

;; A rounded box; optional title inside at the top
(defwidget bp-card [?title]
  (box :class "bp-card" :orientation "v" :space-evenly false :spacing 10
    (revealer :reveal {title != ""} :transition "none"
      (label :class "bp-section" :halign "start" :text title))
    (children)))

(defwidget bp-meter [value]
  (progress :class "bp-meter ${value >= 90 ? 'bp-hot' : value >= 75 ? 'bp-warm' : ''}"
            :value value :orientation "h"))

(defwidget bp-stat [label value]
  (box :class "bp-stat" :orientation "v" :space-evenly false :spacing 2
    (label :class "bp-stat-value" :limit-width 16 :text value)
    (label :class "bp-stat-label" :text label)))

(defwidget bp-row [name value]
  (box :class "bp-row" :space-evenly false :spacing 8
    (label :class "bp-row-name" :halign "start" :hexpand true :xalign 0 :limit-width 28 :text name)
    (label :class "bp-row-value" :text value)))

;; Close an app (two clicks: × then "Close?")
(defwidget bp-close [proc id]
  (eventbox :cursor "pointer"
    (button :class "bp-x ${bp_confirm == id ? 'bp-x-sure' : ''}"
            :tooltip {bp_confirm == id ? "Click again to close it" : "Close this app"}
            :onclick "~/.config/bspwm/bin/BarPanelAction confirm '${id}' close '${proc}' &"
      {bp_confirm == id ? "Close?" : "󰅖"})))

(defwidget bp-app [name value pct]
  (box :class "bp-app" :orientation "v" :space-evenly false :spacing 5
    (bp-row :name name :value value)
    (progress :class "bp-thin" :value pct :orientation "h")))

(defwidget bp-button [text onclick ?icon]
  (eventbox :cursor "pointer" :hexpand true
    (button :class "bp-button" :onclick onclick
      (box :space-evenly false :spacing 8 :halign "center"
        (label :class "bp-btn-icon" :visible {icon != ""} :text icon)
        (label :class "bp-btn-text" :text text)))))

(defwidget bp-slider [icon value onchange onclick ?max]
  (box :class "bp-slider-row" :space-evenly false :spacing 10
    (eventbox :cursor "pointer"
      (button :class "bp-round" :onclick onclick icon))
    (eventbox :cursor "pointer" :hexpand true
      (scale :class "bp-slider" :hexpand true :min 0 :max {max == "" ? 101 : max}
             :value value :onchange onchange))
    (label :class "bp-slider-value" :text "${value}%")))

;; Row that drills into a list (Wi-Fi, Bluetooth): the round icon switches it
;; on/off, the rest of the row (with the arrow) opens the list
(defwidget bp-nav [icon title sub on toggle open]
  (box :class "bp-nav" :space-evenly false :spacing 12
    (eventbox :cursor "pointer" :tooltip {on ? "Turn off" : "Turn on"}
      (button :class "bp-round ${on ? 'bp-round-on' : ''}" :onclick toggle icon))
    (eventbox :cursor "pointer" :hexpand true
      (button :class "bp-nav-open" :onclick open
        (box :space-evenly false :spacing 8
          (box :orientation "v" :space-evenly false :hexpand true :valign "center"
            (label :class "bp-nav-title" :halign "start" :text title)
            (label :class "bp-nav-sub" :halign "start" :xalign 0 :limit-width 26 :text sub))
          (label :class "bp-chev" :text "󰅂"))))))

;; Header of a list view: back arrow, title, on/off switch
(defwidget bp-subhead [title on toggle]
  (box :class "bp-subhead" :space-evenly false :spacing 10
    (eventbox :cursor "pointer"
      (button :class "bp-round" :tooltip "Back" :onclick "~/.config/bspwm/bin/BarPanelAction view main &" "󰅁"))
    (label :class "bp-title" :halign "start" :hexpand true :text title)
    (bp-switch :on on :toggle toggle)))

;; On/off switch: a track with a knob that sits left (off) or right (on).
;; Plain boxes, not a button, so the GTK theme's button padding can't change its size.
(defwidget bp-switch-face [on]
  (box :class "bp-switch ${on ? 'bp-switch-on' : ''}" :space-evenly false :valign "center"
    (box :class "bp-switch-knob" :hexpand true :valign "center" :halign {on ? "end" : "start"})))

(defwidget bp-switch [on toggle]
  (eventbox :cursor "pointer" :onclick toggle :valign "center" :tooltip {on ? "Turn off" : "Turn on"}
    (bp-switch-face :on on)))

;; A setting that's on or off: icon, name, a line under it, switch.
;; The whole row is one click target.
(defwidget bp-toggle [icon title sub on toggle]
  (eventbox :cursor "pointer" :onclick toggle
    (box :class "bp-toggle" :space-evenly false :spacing 16   ;; 16 = text lines up with bp-nav rows
      (label :class "bp-round ${on ? 'bp-round-on' : ''}" :text icon)
      (box :orientation "v" :space-evenly false :hexpand true :valign "center"
        (label :class "bp-nav-title" :halign "start" :text title)
        (label :class "bp-nav-sub" :halign "start" :xalign 0 :limit-width 22 :text sub))
      (bp-switch-face :on on))))

;; ----- sections (each dropdown shows them in the order saved in
;; config/dropdowns.json: Control Center > Dropdowns) -----

(defwidget bp-s-cpu_graph []
  (bp-card :title "Last minute"
    (graph :class "bp-graph" :value {bp_cpu.total} :time-range "60s" :min 0 :max 100
           :dynamic false :thickness 2 :line-style "round" :height 56)
    (box :class "bp-cores" :spacing 4 :height 30
      (for c in {bp_cpu.cores}
        (progress :class "bp-core ${c >= 90 ? 'bp-hot' : ''}" :orientation "v" :flipped true :value c)))))

(defwidget bp-s-cpu_stats []
  (box :class "bp-card bp-stats" :space-evenly true
    (bp-stat :label "Temperature" :value {bp_cpu.temp == "" ? "–" : bp_cpu.temp})
    (bp-stat :label "Load average" :value {bp_cpu.load})
    (bp-stat :label "Threads" :value {bp_cpu.threads})))

(defwidget bp-s-cpu_apps []
  (bp-card :title "Using the most CPU"
    (label :class "bp-dim" :halign "start" :visible {arraylength(bp_cpu.procs) == 0} :text "Measuring…")
    (box :orientation "v" :space-evenly false :spacing 8
      (for p in {bp_cpu.procs}
        (box :space-evenly false :spacing 6
          (box :hexpand true (bp-row :name {p.name} :value "${p.pct}%"))
          (box :visible {p.kill} (bp-close :proc {p.proc} :id "close:${p.proc}"))
          (box :visible {!p.kill} :class "bp-x-space"))))))

(defwidget bp-s-cpu_button []
  (bp-button :icon "󰍹" :text "System Monitor"
             :onclick "~/.config/bspwm/bin/BarPanelAction run gnome-system-monitor -r &"))

(defwidget bp-s-memory_graph []
  (bp-card :title "Last minute"
    (graph :class "bp-graph" :value {bp_memory.pct} :time-range "60s" :min 0 :max 100
           :dynamic false :thickness 2 :line-style "round" :height 48)
    (bp-row :name "Swap" :value "${bp_memory.swap_used} of ${bp_memory.swap_total}")
    (bp-meter :value {bp_memory.swap_pct})))

(defwidget bp-s-memory_apps []
  (bp-card :title "Apps using the most memory"
    (box :orientation "v" :space-evenly false :spacing 8
      (for a in {bp_memory.apps}
        (box :space-evenly false :spacing 6
          (box :hexpand true (bp-row :name {a.name} :value {a.size}))
          (box :visible {a.kill} (bp-close :proc {a.proc} :id "close:${a.proc}"))
          (box :visible {!a.kill} :class "bp-x-space"))))))

(defwidget bp-s-memory_button []
  (bp-button :icon "󰍹" :text "System Monitor"
             :onclick "~/.config/bspwm/bin/BarPanelAction run gnome-system-monitor -p &"))

;; One clean-up action: red badge, what it is, a red button (one click)
(defwidget bp-clean [icon title sub id action label]
  (box :class "bp-clean" :space-evenly false :spacing 12
    (label :class "bp-clean-badge" :valign "center" :text icon)
    (box :orientation "v" :space-evenly false :hexpand true :valign "center"
      (label :class "bp-item-name" :halign "start" :text title)
      (label :class "bp-item-sub" :halign "start" :xalign 0 :limit-width 24 :text sub))
    (eventbox :cursor "pointer" :valign "center"
      (button :class "bp-danger" :onclick "~/.config/bspwm/bin/BarPanelAction ${action} &" label))))

(defwidget bp-s-disk_clean []
  (box :class "bp-card" :orientation "v" :space-evenly false :spacing 8
    (box :space-evenly false
      (label :class "bp-section" :halign "start" :hexpand true :text "Clean up")
      (label :class "bp-dim" :text "up to ${bp_disk.total}"))
    (box :orientation "v" :space-evenly false :spacing 8
      (bp-clean :icon "󰃢" :title "App caches" :sub "${bp_disk.cache} · thumbnails, browsers"
                :id "clean-cache" :action "clean-cache" :label "Clear")
      (box :class "bp-sep bp-sep-clean")
      (bp-clean :icon "󰏗" :title "Package cache" :sub "${bp_disk.pkgs} · old downloads"
                :id "clean-packages" :action "clean-packages" :label "Clear")
      (box :visible {bp_disk.orphans > 0} :orientation "v" :space-evenly false :spacing 8
        (box :class "bp-sep bp-sep-clean")
        (bp-clean :icon "󰆴" :title "Unused packages"
                  :sub "${bp_disk.orphans} that nothing needs"
                  :id "clean-orphans" :action "clean-orphans" :label "Remove")))))

(defwidget bp-s-disk_buttons []
  (box :space-evenly true :spacing 8
    (bp-button :icon "󰉋" :text "Files" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/OpenApps --filemanager &")
    (bp-button :icon "󰄨" :text "Analyze" :onclick "~/.config/bspwm/bin/BarPanelAction run kitty -e ncdu ~ &")))

(defwidget bp-s-sound_volume []
  (box :class "bp-card" :orientation "v" :space-evenly false :spacing 6
    (bp-slider :icon {bp_sound.muted ? "󰖁" : "󰕾"} :value {bp_sound.vol}
               :onchange "~/.config/bspwm/bin/BarPanelAction vol-set {} &" :onclick "~/.config/bspwm/bin/BarPanelAction vol-mute &")
    (label :class "bp-slider-sub" :halign "start" :xalign 0 :limit-width 34
           :text {bp_sound.muted ? "Muted · ${bp_sound.output}" : "Playing through ${bp_sound.output}"})))

;; (only when there's a choice: more than one output)
(defwidget bp-s-sound_output []
  (box :visible {arraylength(bp_sound.sinks) > 1}
    (bp-card :title "Play sound through"
      (box :orientation "v" :space-evenly false :spacing 2
        (for s in {bp_sound.sinks}
          (eventbox :cursor "pointer"
            (button :class "bp-item ${s.default ? 'bp-item-on' : ''}"
                    :onclick "~/.config/bspwm/bin/BarPanelAction sink '${s.name}' &"
              (box :space-evenly false :spacing 12
                (label :class "bp-item-icon"
                       :text {s.kind == "headphones" ? "󰋋" : s.kind == "hdmi" ? "󰡁" : s.kind == "bluetooth" ? "󰂯" : "󰓃"})
                (label :class "bp-item-name" :halign "start" :hexpand true :xalign 0 :limit-width 30 :text {s.desc})
                (label :class "bp-check" :visible {s.default} :text "󰄬")))))))))

(defwidget bp-s-sound_mic []
  (box :class "bp-card" :orientation "v" :space-evenly false :spacing 6
    (bp-slider :icon {bp_sound.mic_muted ? "󰍭" : "󰍬"} :value {bp_sound.mic_vol}
               :onchange "~/.config/bspwm/bin/BarPanelAction mic-set {} &" :onclick "~/.config/bspwm/bin/BarPanelAction mic-mute &")
    (label :class "bp-slider-sub" :halign "start" :xalign 0 :limit-width 34
           :text {bp_sound.mic_muted ? "Muted · ${bp_sound.mic}" : bp_sound.mic})))

(defwidget bp-s-sound_button []
  (bp-button :icon "󰒓" :text "Sound Settings" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/ControlCenter sound &"))

(defwidget bp-s-network_speed []
  (box :class "bp-card bp-stats" :space-evenly true
    (bp-stat :label "󰁅 Download" :value {bp_network.down})
    (bp-stat :label "󰁝 Upload" :value {bp_network.up})))

(defwidget bp-s-network_button []
  (bp-button :icon "󰒓" :text "Network Settings" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/ControlCenter network &"))

(defwidget bp-s-battery_brightness []
  (bp-card :title "Display brightness"
    (bp-slider :icon "󰃠" :value {bp_battery.bright} :max 100
               :onchange "~/.config/bspwm/bin/BarPanelAction bright {} &" :onclick "")))

(defwidget bp-s-battery_buttons []
  (box :space-evenly true :spacing 8
    (bp-button :icon "󰒓" :text "Settings" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/ControlCenter power &")
    (bp-button :icon "󰐥" :text "Power Off…" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/OpenApps --powermenu &")))

(defwidget bp-s-network_airplane []
  (bp-toggle :icon "󰀝" :title "Airplane mode" :on {bp_network.airplane}
             :sub {bp_network.airplane ? "On" : "Off"}
             :toggle "~/.config/bspwm/bin/BarPanelAction airplane &"))

(defwidget bp-s-network_wifi []
  (bp-nav :icon {bp_network.wifi_on ? "󰖩" : "󰖪"} :title "Wi-Fi" :on {bp_network.wifi_on}
          :sub {bp_network.wifi_on ? (bp_network.kind == "wifi" ? bp_network.name : "Not connected") : "Off"}
          :toggle "~/.config/bspwm/bin/BarPanelAction wifi-toggle &" :open "~/.config/bspwm/bin/BarPanelAction view wifi &"))

(defwidget bp-s-network_bluetooth []
  (bp-nav :icon {bp_network.bt_on ? "󰂯" : "󰂲"} :title "Bluetooth" :on {bp_network.bt_on}
          :sub {bp_network.bt_on ? (bp_network.bt_dev != "" ? bp_network.bt_dev : "On") : "Off"}
          :toggle "~/.config/bspwm/bin/BarPanelAction bt-toggle &" :open "~/.config/bspwm/bin/BarPanelAction view bt &"))

(defwidget bp-s-battery_night []
  (bp-toggle :icon "󰖔" :title "Night light" :on {bp_battery.night}
             :sub {bp_battery.night ? "On · ${bp_battery.night_temp} K" : "Off"}
             :toggle "~/.config/bspwm/bin/BarPanelAction night &"))

(defwidget bp-s-battery_awake []
  (bp-toggle :icon "󰛊" :title "Keep awake" :on {bp_battery.awake}
             :sub {bp_battery.awake ? "On · won't sleep" : "Off"}
             :toggle "~/.config/bspwm/bin/BarPanelAction awake &"))

(defwidget bp-s-battery_mode []
  (box :visible {arraylength(bp_battery.profiles) > 0}
    (box :class "bp-card" :orientation "v" :space-evenly false :spacing 10
      (box :class "bp-card-head" :space-evenly false
        (label :class "bp-section" :halign "start" :valign "center" :text "Power mode")
        (label :class "bp-dim bp-mode-now" :halign "start" :hexpand true :valign "center"
               :text {bp_battery.profile_name != "" ? "· ${bp_battery.profile_name}" : ""})
        ;; not allowed yet: one small button instead of a sentence
        (box :visible {!bp_battery.can_profile}
          (eventbox :cursor "pointer"
            (button :class "bp-chip bp-chip-small" :tooltip "Asks for your password once"
                    :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/PowerMode --setup &"
              "󰌾 Allow changes…"))))
      ;; one segmented strip; the current mode filled with the accent
      (box :class "bp-seg ${bp_battery.can_profile ? '' : 'bp-seg-locked'}" :space-evenly true :spacing 2
        (for p in {bp_battery.profiles}
          (eventbox :cursor {bp_battery.can_profile ? "pointer" : "default"}
                    :onclick {bp_battery.can_profile ? "~/.config/bspwm/bin/BarPanelAction power-mode ${p.id} &" : ""}
            (box :class "bp-seg-item ${p.id == bp_battery.profile ? 'bp-seg-on' : ''}" :tooltip {p.name}
              (label :class "bp-seg-icon" :hexpand true :text {p.icon}))))))))

;; ----- order -----

(defwidget bp-c-network_rows []
  (box :class "bp-card bp-list" :orientation "v" :space-evenly false :spacing 4
    (for r in {bp_show.order.network_rows}
      (box :visible {bp_show[r]} :orientation "v" :space-evenly false :spacing 4
        (box :class "bp-sep" :visible {r != bp_show.first.network_rows})
          (box :visible {r == "network_airplane"} :orientation "v" :space-evenly false (bp-s-network_airplane))
          (box :visible {r == "network_wifi"} :orientation "v" :space-evenly false (bp-s-network_wifi))
          (box :visible {r == "network_bluetooth"} :orientation "v" :space-evenly false (bp-s-network_bluetooth))))))

(defwidget bp-c-battery_toggles []
  (box :class "bp-card bp-list" :orientation "v" :space-evenly false :spacing 2
    (for r in {bp_show.order.battery_toggles}
      (box :visible {bp_show[r]} :orientation "v" :space-evenly false :spacing 2
        (box :class "bp-sep" :visible {r != bp_show.first.battery_toggles})
          (box :visible {r == "battery_night"} :orientation "v" :space-evenly false (bp-s-battery_night))
          (box :visible {r == "battery_awake"} :orientation "v" :space-evenly false (bp-s-battery_awake))))))

(defwidget bp-o-cpu []
  (box :visible {bp_show.any.cpu} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.cpu}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "cpu_graph"} :orientation "v" :space-evenly false (bp-s-cpu_graph))
        (box :visible {k == "cpu_stats"} :orientation "v" :space-evenly false (bp-s-cpu_stats))
        (box :visible {k == "cpu_apps"} :orientation "v" :space-evenly false (bp-s-cpu_apps))
        (box :visible {k == "cpu_button"} :orientation "v" :space-evenly false (bp-s-cpu_button))))))

(defwidget bp-o-memory []
  (box :visible {bp_show.any.memory} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.memory}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "memory_graph"} :orientation "v" :space-evenly false (bp-s-memory_graph))
        (box :visible {k == "memory_apps"} :orientation "v" :space-evenly false (bp-s-memory_apps))
        (box :visible {k == "memory_button"} :orientation "v" :space-evenly false (bp-s-memory_button))))))

(defwidget bp-o-disk []
  (box :visible {bp_show.any.disk} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.disk}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "disk_clean"} :orientation "v" :space-evenly false (bp-s-disk_clean))
        (box :visible {k == "disk_buttons"} :orientation "v" :space-evenly false (bp-s-disk_buttons))))))

(defwidget bp-o-sound []
  (box :visible {bp_show.any.sound} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.sound}
      ;; (the device list only when there's a choice, without leaving a gap)
      (box :visible {bp_show[k] && (k != "sound_output" || arraylength(bp_sound.sinks) > 1)} :orientation "v" :space-evenly false
        (box :visible {k == "sound_volume"} :orientation "v" :space-evenly false (bp-s-sound_volume))
        (box :visible {k == "sound_output"} :orientation "v" :space-evenly false (bp-s-sound_output))
        (box :visible {k == "sound_mic"} :orientation "v" :space-evenly false (bp-s-sound_mic))
        (box :visible {k == "sound_button"} :orientation "v" :space-evenly false (bp-s-sound_button))))))

(defwidget bp-o-network []
  (box :visible {bp_show.any.network} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.network}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "network_speed"} :orientation "v" :space-evenly false (bp-s-network_speed))
        (box :visible {k == "network_rows"} :orientation "v" :space-evenly false (bp-c-network_rows))
        (box :visible {k == "network_button"} :orientation "v" :space-evenly false (bp-s-network_button))))))

(defwidget bp-o-battery []
  (box :visible {bp_show.any.battery} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.battery}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "battery_mode"} :orientation "v" :space-evenly false (bp-s-battery_mode))
        (box :visible {k == "battery_brightness"} :orientation "v" :space-evenly false (bp-s-battery_brightness))
        (box :visible {k == "battery_toggles"} :orientation "v" :space-evenly false (bp-c-battery_toggles))
        (box :visible {k == "battery_buttons"} :orientation "v" :space-evenly false (bp-s-battery_buttons))))))

;; ================= CPU =================

(defwidget bp-cpu-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon "󰍛" :title "Processor" :sub {bp_cpu.model} :value "${bp_cpu.total}%")
    (bp-o-cpu)))

;; ================= Memory =================

(defwidget bp-memory-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon "󰘚" :title "Memory" :sub "${bp_memory.used} of ${bp_memory.total} · ${bp_memory.free} free"
             :value "${bp_memory.pct}%")
    (bp-o-memory)))

;; ================= Storage =================

(defwidget bp-disk-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon "󰋊" :title "Storage"
             :sub {arraylength(bp_disk.disks) > 0 ? "${bp_disk.disks[0].free} free on the system drive" : ""}
             :value {arraylength(bp_disk.disks) > 0 ? "${bp_disk.disks[0].pct}%" : ""})
    (box :orientation "v" :space-evenly false :spacing 12    ;; (own box: keeps the disks above the sections)
      (for d in {bp_disk.disks}
        (bp-card :title {d.name}
          (bp-meter :value {d.pct})
          (box :space-evenly false
            (label :class "bp-dim" :halign "start" :hexpand true :text "${d.used} of ${d.size}")
            (label :class "bp-dim" :text "${d.free} free")))))
    (bp-o-disk)))

;; ================= Sound =================

(defwidget bp-sound-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon {bp_sound.muted ? "󰖁" : "󰕾"} :title "Sound" :sub {bp_sound.output}
             :value {bp_sound.muted ? "Muted" : "${bp_sound.vol}%"})
    (bp-o-sound)))

;; ================= Network =================

(defwidget bp-network-main []
  (box :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon {bp_network.kind == "wifi" ? "󰖩" : bp_network.kind == "ethernet" ? "󰈀" : "󰭚"}
             :title {bp_network.kind == "none" ? "Not connected" : bp_network.name}
             :sub {bp_network.kind == "none" ? "" : "${bp_network.kind == 'wifi' ? 'Wi-Fi' : 'Ethernet'} · ${bp_network.ip}"}
             :value {bp_network.kind == "wifi" ? "${bp_network.signal}%" : ""})
    (bp-o-network)))

(defwidget bp-wifi-list []
  (box :orientation "v" :space-evenly false :spacing 12
    (bp-subhead :title "Wi-Fi" :on {bp_network.wifi_on} :toggle "~/.config/bspwm/bin/BarPanelAction wifi-toggle &")
    (box :class "bp-card bp-list" :orientation "v" :space-evenly false :spacing 2
      (box :space-evenly false :class "bp-list-head"
        (label :class "bp-section" :halign "start" :hexpand true
               :text {!bp_network.wifi_on ? "Wi-Fi is off" : bp_scanning ? "Searching for networks…" : "Networks"})
        (revealer :reveal {bp_network.wifi_on && !bp_scanning} :transition "none"
         (eventbox :cursor "pointer"
          (button :class "bp-mini" :tooltip "Search again" :onclick "~/.config/bspwm/bin/BarPanelAction wifi-scan &" "󰑐"))))
      ;; At least 4 rows tall, so the dropdown doesn't jump while it searches
      (revealer :reveal {bp_network.wifi_on && arraylength(bp_wifi.networks) == 0} :transition "none"
        (label :class "bp-dim bp-list-empty" :height 188 :valign "center"
               :text {bp_scanning ? "Looking for networks nearby…" : "No networks found"}))
      (revealer :reveal {bp_network.wifi_on && arraylength(bp_wifi.networks) > 0} :transition "none"
      (scroll :vscroll true :hscroll false
              :height {arraylength(bp_wifi.networks) > 7 ? 330 : arraylength(bp_wifi.networks) < 4 ? 188 : arraylength(bp_wifi.networks) * 46 + 4}
        (box :orientation "v" :space-evenly false :spacing 2
          (for n in {bp_wifi.networks}
           (box :orientation "v" :space-evenly false
            (eventbox :cursor "pointer"
              (button :class "bp-item ${n.active || bp_ask == '${n.i}' ? 'bp-item-on' : ''}"
                      :onclick "~/.config/bspwm/bin/BarPanelAction wifi-connect ${n.i} &"
                (box :space-evenly false :spacing 12
                  (label :class "bp-item-icon"
                         :text {n.bars == 4 ? "󰤨" : n.bars == 3 ? "󰤥" : n.bars == 2 ? "󰤢" : "󰤟"})
                  (box :orientation "v" :space-evenly false :hexpand true :valign "center"
                    (label :class "bp-item-name" :halign "start" :xalign 0 :limit-width 26 :text {n.ssid})
                    (label :class "bp-item-sub" :halign "start"
                           :visible {n.active || n.known || n.connecting || bp_connecting == n.ssid}
                           :text {n.connecting || bp_connecting == n.ssid ? "Connecting…" : n.active ? "Connected" : "Saved"}))
                  (label :class "bp-item-lock" :visible {n.secure} :text "󰌾")
                  (label :class "bp-check" :visible {n.active} :text "󰄬"))))))))))
    (box :space-evenly true :spacing 8
      (bp-button :icon "󰐕" :text "Other Network…" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/OpenApps --netmanager &")
      (bp-button :icon "󰒓" :text "Settings" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/ControlCenter network &"))))

(defwidget bp-bt-list []
  (box :orientation "v" :space-evenly false :spacing 12
    (bp-subhead :title "Bluetooth" :on {bp_network.bt_on} :toggle "~/.config/bspwm/bin/BarPanelAction bt-toggle &")
    (box :class "bp-card bp-list" :orientation "v" :space-evenly false :spacing 2
      (label :class "bp-section bp-list-head" :halign "start"
             :text {!bp_network.bt_on ? "Bluetooth is off" : arraylength(bp_bt.devices) == 0 ? "No paired devices" : "My devices"})
      (for d in {bp_bt.devices}
        (eventbox :cursor "pointer" :visible {bp_network.bt_on}
          (button :class "bp-item ${d.connected ? 'bp-item-on' : ''}"
                  :onclick "~/.config/bspwm/bin/BarPanelAction bt-connect ${d.mac} &"
                  :tooltip {d.connected ? "Disconnect" : "Connect"}
            (box :space-evenly false :spacing 12
              (label :class "bp-item-icon"
                     :text {d.icon == "phone" ? "󰄜" : d.icon == "computer" ? "󰌢" : d.icon =~ "audio" ? "󰋋" : d.icon =~ "keyboard" ? "󰌌" : d.icon =~ "mouse" ? "󰍽" : "󰂯"})
              (box :orientation "v" :space-evenly false :hexpand true :valign "center"
                (label :class "bp-item-name" :halign "start" :xalign 0 :limit-width 26 :text {d.name})
                (label :class "bp-item-sub" :halign "start"
                       :text {bp_connecting == d.mac ? "Connecting…" : d.connected ? (d.battery != "" ? "Connected · ${d.battery}%" : "Connected") : "Not connected"}))
              (label :class "bp-check" :visible {d.connected} :text "󰄬"))))))
    (bp-button :icon "󰐕" :text "Pair New Device…" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/ControlCenter bluetooth &")))

(defwidget bp-network-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false
    ;; (revealers, not :visible: eww shows hidden widgets for a moment when a
    ;; window opens, which would size the dropdown for all three views)
    (revealer :reveal {bp_view == "main"} :transition "none" (bp-network-main))
    (revealer :reveal {bp_view == "wifi"} :transition "none" (bp-wifi-list))
    (revealer :reveal {bp_view == "bt"} :transition "none" (bp-bt-list))))

;; ================= Battery =================

(defwidget bp-battery-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon {bp_battery.status == "Charging" ? "󰂄" : "󰁹"} :title "Battery"
             :sub {bp_battery.time != "" ? bp_battery.time : bp_battery.status}
             :value "${bp_battery.pct}%")
    (bp-o-battery)))

;; ================= Calendar =================

(defwidget bp-s-calendar_month []
  (box :orientation "v" :space-evenly false
    ;; (scroll over the month to go back and forward)
    (eventbox :onscroll "~/.config/bspwm/bin/BarPanelAction cal {} &"
      (box :class "bp-card bp-cal" :orientation "v" :space-evenly false :spacing 2
        (box :class "bp-cal-head" :space-evenly false :spacing 4
          (label :class "bp-cal-title" :halign "start" :hexpand true :text {bp_calendar.title})
          (box :visible {bp_calendar.offset != 0}
            (eventbox :cursor "pointer"
              (button :class "bp-chip" :onclick "~/.config/bspwm/bin/BarPanelAction cal today &" "Today")))
          (eventbox :cursor "pointer"
            (button :class "bp-mini" :tooltip "Previous month" :onclick "~/.config/bspwm/bin/BarPanelAction cal prev &" "󰅁"))
          (eventbox :cursor "pointer"
            (button :class "bp-mini" :tooltip "Next month" :onclick "~/.config/bspwm/bin/BarPanelAction cal next &" "󰅂")))
        (box :class "bp-cal-row" :space-evenly true
          (for w in {bp_calendar.weekdays}
            (label :class "bp-cal-wd" :text w)))
        (for week in {bp_calendar.weeks}
          (box :class "bp-cal-row" :space-evenly true
            (for d in week
              (box :halign "center"
                (label :class "bp-cal-day ${d.in ? '' : 'bp-cal-out'} ${d.today ? 'bp-cal-today' : ''}"
                       :text {d.d})))))))))

(defwidget bp-s-calendar_week []
  (box :class "bp-card bp-stats" :space-evenly true
    (bp-stat :label "Week" :value {formattime(EWW_TIME, "%V")})
    (bp-stat :label "Day of the year" :value {formattime(EWW_TIME, "%-j")})
    (bp-stat :label "Time zone" :value {formattime(EWW_TIME, "%Z")})))

(defwidget bp-o-calendar []
  (box :visible {bp_show.any.calendar} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.calendar}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "calendar_month"} :orientation "v" :space-evenly false (bp-s-calendar_month))
        (box :visible {k == "calendar_week"} :orientation "v" :space-evenly false (bp-s-calendar_week))))))

(defwidget bp-calendar-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon "󰃭" :title {formattime(EWW_TIME, "%A")}
             :sub {formattime(EWW_TIME, "%B %-d, %Y")} :value {formattime(EWW_TIME, "%H:%M")})
    (bp-o-calendar)))

;; ================= media, weather, clipboard, screenshot, power, windows =================

(defpoll bp_media :interval "1s" :run-while {bp_open == "media"}
  :initial '{"has":false,"playing":false,"player":"","title":"","artist":"","art":"","pos":"","len":"","pct":0,"seek":false}'
  "~/.config/bspwm/bin/BarPanelData media")
(defpoll bp_weather :interval "60s" :run-while {bp_open == "weather"}
  :initial '{"ok":false,"place":"Weather","temp":"","desc":"","icon":"󰝚","hours":[],"days":[]}'
  "~/.config/bspwm/bin/BarPanelData weather")
(defpoll bp_clipboard :interval "2s" :run-while {bp_open == "clipboard"}
  :initial '{"count":0,"items":[]}'
  "~/.config/bspwm/bin/BarPanelData clipboard")
(defpoll bp_capture :interval "1s" :run-while {bp_open == "capture"}
  :initial '{"recording":false,"since":"","last":"","last_name":""}'
  "~/.config/bspwm/bin/BarPanelData capture")
(defpoll bp_power :interval "30s" :run-while {bp_open == "power"}
  :initial '{"user":"","host":"","uptime":"","kernel":""}'
  "~/.config/bspwm/bin/BarPanelData power")
(defpoll bp_windows :interval "2s" :run-while {bp_open == "windows"}
  :initial '{"desktop":"","layout":"tiled","count":0,"focused":"","fstate":"","fsticky":false,"items":[]}'
  "~/.config/bspwm/bin/BarPanelData windows")

;; ----- media -----

(defwidget bp-s-media_now []
  (box :class "bp-card" :space-evenly false :spacing 14
    (box :class "bp-art" :visible {bp_media.art != ""} :style "background-image: url('${bp_media.art}');")
    (box :class "bp-art bp-art-empty" :visible {bp_media.art == ""}
      (label :class "bp-art-icon" :hexpand true :text "󰝚"))
    (box :orientation "v" :space-evenly false :spacing 3 :valign "center" :hexpand true
      (label :class "bp-media-title" :halign "start" :xalign 0 :limit-width 21 :tooltip {bp_media.title} :text {bp_media.title})
      (label :class "bp-sub" :halign "start" :xalign 0 :limit-width 28 :visible {bp_media.artist != ""} :text {bp_media.artist}))))

(defwidget bp-s-media_seek []
  (box :class "bp-card" :orientation "v" :space-evenly false :spacing 2 :visible {bp_media.seek}
    (eventbox :cursor "pointer"
      (scale :class "bp-seek" :hexpand true :min 0 :max 101 :value {bp_media.pct}
             :onchange "~/.config/bspwm/bin/BarPanelAction media seek {} &"))
    (box
      (label :class "bp-media-time" :halign "start" :text {bp_media.pos})
      (label :class "bp-media-time" :halign "end" :text {bp_media.len}))))

(defwidget bp-s-media_controls []
  (box :halign "center" :space-evenly false :spacing 22
    (eventbox :cursor "pointer" :tooltip "Previous"
      (button :class "bp-round" :onclick "~/.config/bspwm/bin/BarPanelAction media prev &" "󰒮"))
    (eventbox :cursor "pointer" :tooltip {bp_media.playing ? "Pause" : "Play"}
      (button :class "bp-round bp-round-on bp-play" :onclick "~/.config/bspwm/bin/BarPanelAction media play &" {bp_media.playing ? "󰏤" : "󰐊"}))
    (eventbox :cursor "pointer" :tooltip "Next"
      (button :class "bp-round" :onclick "~/.config/bspwm/bin/BarPanelAction media next &" "󰒭"))))

(defwidget bp-s-media_button []
  (bp-button :icon "󰝚" :text "Music player" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/OpenApps --music &"))

(defwidget bp-o-media []
  (box :visible {bp_show.any.media} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.media}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "media_now"} :orientation "v" :space-evenly false (bp-s-media_now))
        (box :visible {k == "media_seek"} :orientation "v" :space-evenly false (bp-s-media_seek))
        (box :visible {k == "media_controls"} :orientation "v" :space-evenly false (bp-s-media_controls))
        (box :visible {k == "media_button"} :orientation "v" :space-evenly false (bp-s-media_button))))))

(defwidget bp-media-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon "󰝚" :title "Media"
             :sub {bp_media.has ? "${bp_media.player} · ${bp_media.playing ? 'Playing' : 'Paused'}" : "Nothing playing"} :value "")
    (box :visible {bp_media.has && bp_show.any.media} :orientation "v" :space-evenly false (bp-o-media))
    (box :visible {!bp_media.has} :orientation "v" :space-evenly false :spacing 12
      (box :class "bp-card"
        (label :class "bp-dim" :hexpand true :wrap true :text "Play something in a browser or music app and it shows up here."))
      (bp-s-media_button))))

;; ----- weather -----

(defwidget bp-s-weather_stats []
  (box :class "bp-card bp-stats" :space-evenly true
    (bp-stat :label "Feels like" :value {bp_weather.feels ?: "–"})
    (bp-stat :label "Humidity" :value {bp_weather.humidity ?: "–"})
    (bp-stat :label "Wind" :value {bp_weather.wind ?: "–"})
    (bp-stat :label "Rain" :value {bp_weather.rain ?: "–"})))

(defwidget bp-s-weather_hours []
  (bp-card :title "Next hours"
    (box :space-evenly true
      (for h in {bp_weather.hours}
        (box :orientation "v" :space-evenly false :spacing 4
          (label :class "bp-w-time" :text {h.t})
          (label :class "bp-w-icon" :text {h.icon})
          (label :class "bp-w-temp" :text {h.temp}))))))

(defwidget bp-s-weather_days []
  (bp-card :title "Next days"
    (box :orientation "v" :space-evenly false :spacing 6
      (for d in {bp_weather.days}
        (box :class "bp-w-day" :space-evenly false :spacing 10
          (label :class "bp-w-dayname" :halign "start" :xalign 0 :text {d.d})
          (label :class "bp-w-icon-small" :text {d.icon})
          (label :class "bp-dim" :halign "start" :xalign 0 :hexpand true :limit-width 16 :text {d.desc})
          (label :class "bp-w-lo" :text {d.lo})
          (label :class "bp-w-hi" :text {d.hi}))))))

(defwidget bp-s-weather_sun []
  (box :class "bp-w-sun" :space-evenly false :spacing 16 :halign "center"
    (label :class "bp-dim" :text "󰖜  Sunrise ${bp_weather.sunrise}")
    (label :class "bp-dim" :text "󰖛  Sunset ${bp_weather.sunset}")))

(defwidget bp-s-weather_buttons []
  (box :spacing 8
    (bp-button :icon "󰑐" :text "Refresh" :onclick "~/.config/bspwm/bin/BarPanelAction weather-refresh &")
    (bp-button :icon "󰍎" :text "Location…" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/ControlCenter bar &")))

(defwidget bp-o-weather []
  (box :visible {bp_show.any.weather} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.weather}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "weather_stats"} :orientation "v" :space-evenly false (bp-s-weather_stats))
        (box :visible {k == "weather_hours"} :orientation "v" :space-evenly false (bp-s-weather_hours))
        (box :visible {k == "weather_days"} :orientation "v" :space-evenly false (bp-s-weather_days))
        (box :visible {k == "weather_sun"} :orientation "v" :space-evenly false (bp-s-weather_sun))
        (box :visible {k == "weather_buttons"} :orientation "v" :space-evenly false (bp-s-weather_buttons))))))

(defwidget bp-weather-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon {bp_weather.icon} :title {bp_weather.place}
             :sub {bp_weather.ok ? "${bp_weather.desc} · ${bp_weather.hi} / ${bp_weather.lo}" : bp_weather.desc}
             :value {bp_weather.temp})
    (box :visible {bp_weather.ok && bp_show.any.weather} :orientation "v" :space-evenly false (bp-o-weather))
    (box :visible {!bp_weather.ok} :orientation "v" :space-evenly false (bp-s-weather_buttons))))

;; ----- clipboard -----

(defwidget bp-s-clipboard_list []
  (box :orientation "v" :space-evenly false
    (box :class "bp-card bp-clip-list" :orientation "v" :space-evenly false :spacing 2 :visible {bp_clipboard.count > 0}
      (for it in {bp_clipboard.items}
        (box :space-evenly false :spacing 6
          (eventbox :cursor "pointer" :hexpand true
            (button :class "bp-clip" :onclick "~/.config/bspwm/bin/BarPanelAction clip-copy ${it.id} &" :tooltip "Copy this again"
              (box :space-evenly false :spacing 10
                (label :class "bp-clip-icon" :text {it.image ? "󰋩" : "󰦨"})
                (label :class "bp-clip-text" :halign "start" :xalign 0 :hexpand true :limit-width 26 :text {it.text}))))
          (eventbox :cursor "pointer"
            (button :class "bp-x" :tooltip "Remove it from the history" :onclick "~/.config/bspwm/bin/BarPanelAction clip-remove ${it.id} &" "󰅖")))))
    (box :class "bp-card" :visible {bp_clipboard.count == 0}
      (label :class "bp-dim" :hexpand true :wrap true :text "Things you copy show up here."))))

(defwidget bp-s-clipboard_clear []
  (box :visible {bp_clipboard.count > 0}
    (eventbox :cursor "pointer" :hexpand true
      (button :class "bp-button bp-clear-all" :onclick "~/.config/bspwm/bin/BarPanelAction clip-clear &"
        (label :class "bp-btn-text" :text "Clear all")))))

(defwidget bp-o-clipboard []
  (box :visible {bp_show.any.clipboard} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.clipboard}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "clipboard_list"} :orientation "v" :space-evenly false (bp-s-clipboard_list))
        (box :visible {k == "clipboard_clear"} :orientation "v" :space-evenly false (bp-s-clipboard_clear))))))

(defwidget bp-clipboard-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon "󰆒" :title "Clipboard"
             :sub {bp_clipboard.count == 0 ? "Nothing copied yet" : "Click one to copy it again"} :value "")
    (bp-o-clipboard)))

;; ----- screenshot -----

(defwidget bp-capture-tile [icon text onclick]
  (eventbox :cursor "pointer" :hexpand true
    (button :class "bp-tile" :onclick onclick
      (box :orientation "v" :space-evenly false :spacing 6
        (label :class "bp-tile-icon" :text icon)
        (label :class "bp-tile-text" :text text)))))

(defwidget bp-s-capture_shots []
  (box :orientation "v" :space-evenly false :spacing 6
    (box :space-evenly true :spacing 6
      (bp-capture-tile :icon "󰍹" :text "Screen" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/Capture screen &")
      (bp-capture-tile :icon "󰆞" :text "Area" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/Capture area &")
      (bp-capture-tile :icon "󰖯" :text "Window" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/Capture window &"))
    (box :space-evenly true :spacing 6
      (bp-capture-tile :icon "󰔛" :text "In 5 s" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/Capture delay 5 &")
      (bp-capture-tile :icon "󱄺" :text "Text" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/Capture text &")
      (bp-capture-tile :icon "󰉦" :text "Colour" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/Colorpicker &"))))

(defwidget bp-s-capture_record []
  (box :class "bp-card bp-rec ${bp_capture.recording ? 'bp-rec-on' : ''}" :space-evenly false :spacing 12
    (label :class "bp-rec-dot" :valign "center" :text "󰑊")
    (box :orientation "v" :space-evenly false :hexpand true :valign "center"
      (label :class "bp-item-name" :halign "start" :text "Screen recording")
      (label :class "bp-item-sub" :halign "start" :xalign 0
             :text {bp_capture.recording ? "Recording · ${bp_capture.since}" : "This screen, with its sound"}))
    (eventbox :cursor "pointer" :valign "center"
      (button :class {bp_capture.recording ? "bp-danger bp-danger-sure" : "bp-chip"}
              :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/Capture record &"
        (label :text {bp_capture.recording ? "Stop" : "Start"})))))

(defwidget bp-s-capture_last []
  (box :class "bp-card" :orientation "v" :space-evenly false :spacing 8 :visible {bp_capture.last != ""}
    (label :class "bp-section" :halign "start" :text "Last screenshot")
    (eventbox :cursor "pointer" :tooltip "Open it"
      (button :class "bp-shot-btn" :onclick "~/.config/bspwm/bin/BarPanelAction run xdg-open '${bp_capture.last}' &"
        (box :class "bp-shot" :style "background-image: url('${bp_capture.last}');")))))

(defwidget bp-s-capture_button []
  (bp-button :icon "󰉋" :text "Screenshots folder"
             :onclick "~/.config/bspwm/bin/BarPanelAction run xdg-open ${replace(bp_capture.last, '/[^/]*$', '')} &"))

(defwidget bp-o-capture []
  (box :visible {bp_show.any.capture} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.capture}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "capture_shots"} :orientation "v" :space-evenly false (bp-s-capture_shots))
        (box :visible {k == "capture_record"} :orientation "v" :space-evenly false (bp-s-capture_record))
        (box :visible {k == "capture_last"} :orientation "v" :space-evenly false (bp-s-capture_last))
        (box :visible {k == "capture_button"} :orientation "v" :space-evenly false (bp-s-capture_button))))))

(defwidget bp-capture-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon "󰄀" :title "Screenshot" :sub "Saved, and copied to the clipboard" :value "")
    (bp-o-capture)))

;; ----- power (the bar's power button) -----

(defwidget bp-power-btn [icon text onclick ?danger ?id]
  (eventbox :cursor "pointer" :hexpand true
    (button :class "bp-tile ${danger == 'true' ? 'bp-tile-danger' : ''} ${id != '' && bp_confirm == id ? 'bp-tile-sure' : ''}"
            :onclick onclick
      (box :orientation "v" :space-evenly false :spacing 6
        (label :class "bp-tile-icon" :text icon)
        (label :class "bp-tile-text" :text {id != "" && bp_confirm == id ? "Sure?" : text})))))

(defwidget bp-s-power_session []
  (box :class "bp-card bp-stats" :space-evenly true
    (bp-stat :label "Up for" :value {bp_power.uptime ?: "–"})
    (bp-stat :label "Computer" :value {bp_power.host ?: "–"})
    (bp-stat :label "Kernel" :value {bp_power.kernel ?: "–"})))

(defwidget bp-s-power_actions []
  (box :space-evenly true :spacing 6
    (bp-power-btn :icon "󰌾" :text "Lock" :onclick "~/.config/bspwm/bin/BarPanelAction run ~/.config/bspwm/bin/ScreenLocker &")
    (bp-power-btn :icon "󰒲" :text "Sleep" :onclick "~/.config/bspwm/bin/BarPanelAction run systemctl suspend &")
    (bp-power-btn :icon "󰍃" :text "Log out" :id "pw:logout"
                  :onclick "~/.config/bspwm/bin/BarPanelAction confirm pw:logout run bspc quit &")))

(defwidget bp-s-power_off []
  (box :space-evenly true :spacing 6
    (bp-power-btn :icon "󰜉" :text "Restart" :id "pw:reboot"
                  :onclick "~/.config/bspwm/bin/BarPanelAction confirm pw:reboot run systemctl reboot &")
    (bp-power-btn :icon "󰐥" :text "Shut down" :danger "true" :id "pw:off"
                  :onclick "~/.config/bspwm/bin/BarPanelAction confirm pw:off run systemctl poweroff &")))

(defwidget bp-o-power []
  (box :visible {bp_show.any.power} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.power}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "power_session"} :orientation "v" :space-evenly false (bp-s-power_session))
        (box :visible {k == "power_actions"} :orientation "v" :space-evenly false (bp-s-power_actions))
        (box :visible {k == "power_off"} :orientation "v" :space-evenly false (bp-s-power_off))))))

(defwidget bp-power-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon "󰀄" :title {bp_power.user ?: "Session"} :sub "Restart and Shut down ask once more" :value "")
    (bp-o-power)))

;; ----- windows (the bar's window title) -----

(defwidget bp-s-windows_list []
  (box :class "bp-card" :orientation "v" :space-evenly false :spacing 2
    (label :class "bp-dim" :halign "start" :visible {bp_windows.count == 0} :text "No windows on this desktop")
    (for w in {bp_windows.items}
      (box :space-evenly false :spacing 6
        (eventbox :cursor "pointer" :hexpand true
          (button :class "bp-clip ${w.focused ? 'bp-win-on' : ''}" :onclick "~/.config/bspwm/bin/BarPanelAction win-focus ${w.id} &" :tooltip "Go to this window"
            (box :space-evenly false :spacing 10
              (label :class "bp-clip-icon" :text {w.state == "floating" ? "󰲏" : w.state == "fullscreen" ? "󰊓" : "󰖯"})
              (box :orientation "v" :space-evenly false :hexpand true
                (label :class "bp-clip-text" :halign "start" :xalign 0 :limit-width 22 :text {w.title})
                (label :class "bp-item-sub" :halign "start" :xalign 0 :limit-width 28 :text {w.cls})))))
        (box :visible {w.hidden}
          (eventbox :cursor "pointer"
            (button :class "bp-chip" :tooltip "Bring it back" :onclick "~/.config/bspwm/bin/BarPanelAction win-show ${w.id} &"
              (label :text "Show"))))
        (eventbox :cursor "pointer"
          (button :class "bp-x" :tooltip "Close this window" :onclick "~/.config/bspwm/bin/BarPanelAction win-close ${w.id} &" "󰅖"))))))

(defwidget bp-s-windows_focused []
  (box :space-evenly true :spacing 6 :visible {bp_windows.focused != ""}
    (bp-power-btn :icon "󰲏" :text {bp_windows.fstate == "floating" ? "Tile" : "Float"}
                  :onclick "~/.config/bspwm/bin/BarPanelAction win-state floating &")
    (bp-power-btn :icon "󰊓" :text {bp_windows.fstate == "fullscreen" ? "Exit full" : "Full screen"}
                  :onclick "~/.config/bspwm/bin/BarPanelAction win-state fullscreen &")
    (bp-power-btn :icon "󰐃" :text {bp_windows.fsticky ? "Unpin" : "Pin"}
                  :onclick "~/.config/bspwm/bin/BarPanelAction win-sticky &")))

(defwidget bp-s-windows_layout []
  (box :class "bp-seg" :space-evenly true
    (eventbox :cursor "pointer"
      (button :class "bp-seg-item ${bp_windows.layout == 'tiled' ? 'bp-seg-on' : ''}" :onclick "~/.config/bspwm/bin/BarPanelAction win-layout tiled &"
        (box :space-evenly false :spacing 6 :halign "center"
          (label :class "bp-seg-icon" :text "󰕰") (label :class "bp-seg-name" :text "Side by side"))))
    (eventbox :cursor "pointer"
      (button :class "bp-seg-item ${bp_windows.layout == 'monocle' ? 'bp-seg-on' : ''}" :onclick "~/.config/bspwm/bin/BarPanelAction win-layout monocle &"
        (box :space-evenly false :spacing 6 :halign "center"
          (label :class "bp-seg-icon" :text "󰖯") (label :class "bp-seg-name" :text "One at a time"))))))

(defwidget bp-o-windows []
  (box :visible {bp_show.any.windows} :orientation "v" :space-evenly false :spacing 12
    (for k in {bp_show.order.windows}
      (box :visible {bp_show[k]} :orientation "v" :space-evenly false
        (box :visible {k == "windows_list"} :orientation "v" :space-evenly false (bp-s-windows_list))
        (box :visible {k == "windows_focused"} :orientation "v" :space-evenly false (bp-s-windows_focused))
        (box :visible {k == "windows_layout"} :orientation "v" :space-evenly false (bp-s-windows_layout))))))

(defwidget bp-windows-panel []
  (box :class "bp-panel" :orientation "v" :space-evenly false :spacing 12
    (bp-head :icon "󰖲" :title "Windows"
             :sub "Desktop ${bp_windows.desktop} · ${bp_windows.count} open" :value "")
    (bp-o-windows)))

;; ----- Wi-Fi password: a small window over the bottom of the network dropdown -----
;; (bspwm manages it so it gets the keyboard; bin/ExternalRules puts it in place.)
;; The typed text goes to a private file through a quoted here-document: quotes in it are safe.

(defwidget bp-wifi-pass-box []
  (box :class "bp-panel bp-ask" :orientation "v" :space-evenly false :spacing 10
    (box :space-evenly false :spacing 10
      (label :class "bp-item-icon" :text "󰖩")
      (box :orientation "v" :space-evenly false :hexpand true
        (label :class "bp-item-name" :halign "start" :xalign 0 :limit-width 26 :text {bp_ask_ssid})
        (label :class "bp-item-sub ${bp_ask_err != '' ? 'bp-ask-err' : ''}" :halign "start" :xalign 0 :limit-width 34
               :text {bp_connecting == bp_ask_ssid && bp_ask_ssid != "" ? "Joining…"
                      : bp_ask_err != "" ? bp_ask_err : "Type the Wi-Fi password"})))
    ;; the field: the password (dots, or text with the eye); red when the last try failed.
    ;; Typing: the text goes to a private file (quoted here-document: quotes are
    ;; safe), Join becomes clickable at 8 characters, a red error clears.
    (box :class "bp-pass-field ${bp_ask_err != '' ? 'bp-pass-bad' : ''}" :space-evenly false :spacing 8
      (input :class "bp-pass" :password {!bp_pass_show} :hexpand true
             :onchange "umask 077; cat > \"$XDG_RUNTIME_DIR/barpanel/wifi-pass\" <<'__BP_PASS__'
{}
__BP_PASS__
n=$(head -n 1 \"$XDG_RUNTIME_DIR/barpanel/wifi-pass\" | wc -m)
eww --no-daemonize -c \"$HOME/.config/bspwm/eww\" update bp_ask_err= bp_pass_ok=$([ \"$n\" -gt 8 ] && echo true || echo false)"
             :onaccept "~/.config/bspwm/bin/BarPanelAction wifi-pass &")
      (eventbox :cursor "pointer" :tooltip {bp_pass_show ? "Hide the password" : "Show the password"}
        (button :class "bp-pass-eye" :onclick "eww --no-daemonize -c $HOME/.config/bspwm/eww update bp_pass_show=${!bp_pass_show} &"
          {bp_pass_show ? "󰈉" : "󰈈"})))
    (box :space-evenly true :spacing 8
      (eventbox :cursor "pointer" :hexpand true
        (button :class "bp-button" :onclick "~/.config/bspwm/bin/BarPanelAction wifi-ask-cancel &"
          (label :class "bp-btn-text" :text "Cancel")))
      (eventbox :cursor {bp_pass_ok && bp_connecting == "" ? "pointer" : "default"} :hexpand true
        (button :class "bp-button bp-button-accent ${bp_pass_ok && bp_connecting == '' ? '' : 'bp-button-off'}"
                :active {bp_pass_ok && bp_connecting == ""}
                :onclick "~/.config/bspwm/bin/BarPanelAction wifi-pass &"
          (label :class "bp-btn-text" :text {bp_connecting == bp_ask_ssid && bp_ask_ssid != "" ? "Joining…" : "Join"}))))))

(defwindow bp-wifi-pass
  :geometry (geometry :width "340px")
  :windowtype "dialog"
  :wm-ignore false
  :focusable true
  :resizable false
  (bp-wifi-pass-box))

;; ================= windows =================

(defwindow bp-cpu      :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-cpu-panel))
(defwindow bp-memory   :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-memory-panel))
(defwindow bp-disk     :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-disk-panel))
(defwindow bp-sound    :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-sound-panel))
(defwindow bp-network  :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-network-panel))
(defwindow bp-battery  :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-battery-panel))
(defwindow bp-calendar :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-calendar-panel))
(defwindow bp-media     :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-media-panel))
(defwindow bp-weather   :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-weather-panel))
(defwindow bp-clipboard :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-clipboard-panel))
(defwindow bp-capture   :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-capture-panel))
(defwindow bp-power     :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-power-panel))
(defwindow bp-windows   :geometry (geometry :width "340px") :stacking "fg" :wm-ignore true :resizable false (bp-windows-panel))

;; Invisible layer under the open dropdown: a click on it closes the dropdown.
;; BarPanel sizes it to everything except the bar, so bar clicks still work.
(defwindow bp-closer
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%" :anchor "top left")
  :stacking "fg"
  :wm-ignore true
  (eventbox :onclick "~/.config/bspwm/bin/BarPanel --close &"
            :onrightclick "~/.config/bspwm/bin/BarPanel --close &"
            :onmiddleclick "~/.config/bspwm/bin/BarPanel --close &"
    (box :class "bp-closer")))
