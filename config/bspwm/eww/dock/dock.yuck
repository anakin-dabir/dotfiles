;; The dock (bin/Dock, Control Center > Appearance): pinned and running apps.
;; Click: open, or go to its window; right click: pin / unpin.

(deflisten dock_items :initial "[]" "~/.config/bspwm/bin/DockData --listen")

(defwidget dock-app [app]
  (eventbox :cursor "pointer" :tooltip {app.name}
            :onclick "~/.config/bspwm/bin/DockAction open '${app.id}' '${app.wid}' &"
            :onrightclick "~/.config/bspwm/bin/DockAction ${app.pinned ? 'unpin' : 'pin'} '${app.id}' &"
    (box :class "dock-app ${app.focused ? 'dock-focused' : ''}" :orientation "v" :space-evenly false :spacing 3
      (image :class "dock-icon" :path {app.icon} :image-width 42 :image-height 42)
      (box :class "dock-dot ${app.running ? 'dock-dot-on' : ''}" :halign "center"))))

(defwidget dock-box []
  (box :class "dock" :space-evenly false :spacing 6
    (for app in dock_items
      (dock-app :app app))))

(defwindow dock
  :geometry (geometry :x "0px" :y "-8px" :anchor "bottom center")
  :stacking "fg"
  :wm-ignore true
  :focusable false
  :resizable false
  (dock-box))
