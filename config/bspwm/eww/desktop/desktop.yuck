;; Desktop widgets (bin/DesktopWidgets, Control Center > Appearance):
;; a clock, what's playing and the weather, on the desktop behind windows.

(defvar dw_show '{"clock":true,"media":false,"weather":false}')
(defpoll dw_media :interval "2s" :run-while {dw_show.media}
  :initial '{"has":false,"playing":false,"title":"","artist":"","art":"","player":""}'
  "~/.config/bspwm/bin/BarPanelData media")
(defpoll dw_weather :interval "600s" :run-while {dw_show.weather}
  :initial '{"ok":false,"place":"","temp":"","desc":"","icon":"","hi":"","lo":""}'
  "~/.config/bspwm/bin/BarPanelData weather")

(defwidget dw []
  (box :class "dw" :orientation "v" :space-evenly false :spacing 16
    (box :visible {dw_show.clock} :class "dw-clock" :orientation "v" :space-evenly false
      (label :class "dw-time" :halign "start" :text {formattime(EWW_TIME, "%H:%M")})
      (label :class "dw-date" :halign "start" :text {formattime(EWW_TIME, "%A, %-d %B")}))
    (box :visible {dw_show.media && dw_media.has} :class "dw-card" :space-evenly false :spacing 14
      (box :class "dw-art" :visible {dw_media.art != ""} :style "background-image: url('${dw_media.art}');")
      (box :class "dw-art dw-art-empty" :visible {dw_media.art == ""} (label :class "dw-icon" :hexpand true :text "󰝚"))
      (box :orientation "v" :space-evenly false :valign "center" :spacing 2 :width 190
        (label :class "dw-title" :halign "start" :xalign 0 :limit-width 24 :text {dw_media.title})
        (label :class "dw-sub" :halign "start" :xalign 0 :limit-width 28 :text {dw_media.artist != "" ? dw_media.artist : dw_media.player})
        (box :space-evenly false :spacing 14 :halign "start" :class "dw-controls"
          (eventbox :cursor "pointer" (button :onclick "~/.config/bspwm/bin/BarPanelAction media prev &" "󰒮"))
          (eventbox :cursor "pointer" (button :onclick "~/.config/bspwm/bin/BarPanelAction media play &" {dw_media.playing ? "󰏤" : "󰐊"}))
          (eventbox :cursor "pointer" (button :onclick "~/.config/bspwm/bin/BarPanelAction media next &" "󰒭")))))
    (box :visible {dw_show.weather && dw_weather.ok} :class "dw-card" :space-evenly false :spacing 14
      (label :class "dw-weather-icon" :valign "center" :text {dw_weather.icon})
      (box :orientation "v" :space-evenly false :valign "center" :spacing 2
        (label :class "dw-title" :halign "start" :text "${dw_weather.temp} · ${dw_weather.place}")
        (label :class "dw-sub" :halign "start" :text "${dw_weather.desc} · ${dw_weather.hi} / ${dw_weather.lo}")))))

(defwindow desktop
  :geometry (geometry :x "40px" :y "60px" :anchor "top left")
  ;; a desktop-type window: the window manager keeps it under every window
  :windowtype "desktop"
  :stacking "bg"
  :wm-ignore false
  :focusable false
  :resizable false
  (dw))
